#!/usr/bin/ucode
'use strict';

import { cursor } from 'uci';
import { writefile } from 'fs';
import * as ubus from 'ubus';

function as_bool(v, def) {
	if (v == null || v == '')
		return def;
	return (v == '1' || v == 1 || v == true || v == 'true' || v == 'on');
}

function nft(script) {
	writefile('/tmp/wan-src-hash.nft', script);
	system('nft -f /tmp/wan-src-hash.nft >/dev/null 2>&1');
}

function iface_up(u, name) {
	try {
		let st = u.call('network.interface.' + name, 'status');
		return st && st.up == true;
	} catch (e) {
		return false;
	}
}

function lan_ifname(ctx, u) {
	let d = ctx.get('network', 'lan', 'device');
	if (d != null && d != '')
		return d;
	d = ctx.get('network', 'lan', 'ifname');
	if (type(d) == 'array')
		d = d[0];
	if (d != null && d != '')
		return split(`${d}`, /[ \t]+/)[0];
	try {
		let st = u.call('network.interface.lan', 'status');
		if (st && st.l3_device)
			return st.l3_device;
	} catch (e) {}
	return 'br-lan';
}

function member_weight(ctx, ifname) {
	let w = 1;
	ctx.foreach('mwan3', 'member', (m) => {
		if (m.interface == ifname)
			w = +(m.weight || 1);
	});
	if (w < 1)
		w = 1;
	if (w > 100)
		w = 100;
	return w;
}

/* flow: 五元组哈希，同一终端多连接可分摊到各 WAN；ip: 旧行为，整 IP 固定一条线 */
function hash_fields(mode) {
	if (mode == 'ip')
		return 'ip saddr';
	return 'ip saddr . ip daddr . th sport . th dport';
}

function weighted_slots(live, ctx) {
	let slots = [];
	for (let w in live) {
		let n = member_weight(ctx, w.ifname);
		for (let i = 0; i < n; i++)
			push(slots, w);
	}
	return slots;
}

system('lock /var/run/wan-src-hash.lock');

let ctx = cursor();
ctx.load('mwan3');
ctx.load('mosdns');
ctx.load('network');
let u = ubus.connect();

let n = 0;
let live = [];
let dead_tables = [];
ctx.foreach('mwan3', 'interface', (s) => {
	if (!as_bool(s.enabled, true))
		return;
	if (s.family != null && s.family != 'ipv4')
		return;
	let sid = s['.name'];
	if (sid == null)
		return;
	n++;
	let table = n;
	let mark = table << 8;
	let port = 5300 + table;
	if (iface_up(u, sid))
		push(live, { mark, port, table, ifname: sid });
	else
		push(dead_tables, table);
});

let pol = ctx.get('mwan3', 'default', 'use_policy') || 'balanced';
let chain = 'mwan3_policy_' + pol;
let live_n = length(live);
let lb_mode = ctx.get('mwan3', 'globals', 'lede_lb_hash') || 'flow';
if (lb_mode != 'ip')
	lb_mode = 'flow';
let hash = hash_fields(lb_mode);

if (live_n > 0) {
	nft(sprintf('flush chain inet mwan3 %s\n', chain));
	if (live_n == 1) {
		nft(sprintf('add rule inet mwan3 %s meta nfproto ipv4 meta mark & 0x00003f00 == 0x00000000 meta mark set meta mark & 0xffffc0ff | %d\n',
			chain, live[0].mark));
	} else {
		let slots = weighted_slots(live, ctx);
		let total = length(slots);
		if (total < 2)
			total = live_n;
		for (let i = 0; i < total; i++) {
			let w = slots[i] || live[i % live_n];
			nft(sprintf('add rule inet mwan3 %s meta nfproto ipv4 meta mark & 0x00003f00 == 0x00000000 jhash %s mod %d == %d meta mark set meta mark & 0xffffc0ff | %d\n',
				chain, hash, total, i, w.mark));
		}
	}
	for (let t in dead_tables)
		nft(sprintf('flush set inet mwan3 mwan3_sticky_v4_default_%d\n', t));
}

let follow = as_bool(ctx.get('mosdns', 'config', 'dns_follow_wan'), true);
if (!follow || live_n < 2) {
	nft('delete table inet dns_follow_wan\n');
} else {
	let listen = ctx.get('mosdns', 'config', 'listen_port') || '5335';
	let lan = lan_ifname(ctx, u);
	let body = '';
	let slots = weighted_slots(live, ctx);
	let total = length(slots);
	if (total < 2)
		total = live_n;
	for (let i = 0; i < total; i++) {
		let w = slots[i] || live[i % live_n];
		let sel = sprintf('jhash ip saddr mod %d == %d redirect to :%d', total, i, w.port);
		body += sprintf('\t\tmeta nfproto ipv4 iifname "%s" udp dport { 53, %s } fib daddr type local %s\n', lan, listen, sel);
		body += sprintf('\t\tmeta nfproto ipv4 iifname "%s" tcp dport { 53, %s } fib daddr type local %s\n', lan, listen, sel);
	}
	nft('delete table inet dns_follow_wan\n');
	nft(sprintf('table inet dns_follow_wan {\n\tchain prerouting {\n\t\ttype nat hook prerouting priority -150; policy accept;\n%s\t}\n}\n', body));
}

printf('wan-src-hash: live=%d mode=%s follow=%s\n', live_n, lb_mode, follow ? '1' : '0');
system('lock -u /var/run/wan-src-hash.lock');
