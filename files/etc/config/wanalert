config wanalert 'main'
	option enabled '0'
	option dingtalk_webhook ''
	option security 'keyword'
	option keyword '线路'
	option dingtalk_secret ''
	option cooldown '120'
	option alert_down '1'
	option alert_up '1'
	option alert_all_down '1'
	option extra_text ''
	option log_enabled '1'
	option log_path '/data/logs/alert/sys-alert.log'
	option log_max_kb '2048'
	option log_sample '0'
	option check_interval '60'
	option alert_hw '1'
	option alert_dhcp '1'
	option dhcp_remain '8'
	option alert_cpu '1'
	option cpu_percent '90'
	option cpu_hold_min '5'
	option alert_load '1'
	option load_warn '2.00'
	option load_hold_min '5'
	option alert_mem '1'
	option mem_percent '90'
	option mem_hold_min '5'
	option alert_disk '1'
	option disk_percent '90'
	list disk_path '/'
	list disk_path '/overlay'
	list disk_path '/data'
	option alert_temp '1'
	option temp_c '80'
	option temp_hold_min '5'
	option alert_track '0'
	option alert_link_speed '0'
	option alert_ppp_fail '0'
	option alert_wan_bw '0'
	option wan_bw_percent '90'
	option wan_bw_hold_min '5'
	option alert_conntrack '1'
	option conn_percent '80'
	option alert_new_mac '0'
	option alert_arp '1'
	option alert_burst_down '0'
	option alert_burst_up '0'
	option burst_down_mbps '50'
	option burst_up_mbps '20'
	option burst_hold_sec '60'
	option alert_login_fail '0'
	option login_fail_n '5'
	option alert_isp '0'
	option alert_overlay '1'
	option alert_smart '0'
	option alert_dns '0'
	option dns_fail_n '2'
	option autofix '0'
	option autofix_wan '1'
	option autofix_cooldown '600'
