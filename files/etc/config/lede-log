config store 'alert'
	option enabled '1'
	option path '/data/logs/alert/sys-alert.log'
	option max_kb '2048'

config store 'syslog'
	option enabled '1'
	option path '/data/logs/syslog/system.log'
	option max_kb '2048'

config store 'kernel'
	option enabled '1'
	option path '/data/logs/kernel/kernel.log'
	option max_kb '2048'

config ui 'ui'
	option page_size_syslog '20'
	option page_size_kernel '20'
	option page_size_alert '20'

config store 'mosdns'
	option enabled '0'
	option path '/data/logs/mosdns/mosdns.log'
	option max_kb '2048'
