#!/bin/sh

if command -v passwd >/dev/null 2>&1; then
  printf 'password\npassword\n' | passwd root >/dev/null 2>&1 || true
fi

uci -q set network.lan.ipaddr='192.168.9.1'
uci -q set network.lan.netmask='255.255.255.0'
uci -q commit network

uci -q set luci.main.mediaurlbase='/luci-static/argon'
uci -q delete luci.main.indexpage 2>/dev/null || true
uci -q set luci.diag.dns='baidu.com'
uci -q set luci.diag.ping='baidu.com'
uci -q set luci.diag.route='baidu.com'
uci -q commit luci
rm -f /etc/config/istorex /etc/config/quickstart /etc/config/istore 2>/dev/null || true

if [ -x /etc/init.d/uhttpd ]; then
  /etc/init.d/uhttpd stop >/dev/null 2>&1 || true
  /etc/init.d/uhttpd disable >/dev/null 2>&1 || true
fi

if [ -x /etc/init.d/nginx ]; then
  # location snippets must be *.locations. A *.conf with only "location"
  # is included at http level and nginx will not start (nothing on 80/443).
  rm -f /etc/nginx/conf.d/lan-speed.conf
  /etc/init.d/nginx enable
  /etc/init.d/nginx restart >/dev/null 2>&1 || /etc/init.d/nginx start >/dev/null 2>&1 || true
fi

if [ -x /etc/init.d/ddns-go ]; then
  /etc/init.d/ddns-go enable
  /etc/init.d/ddns-go start >/dev/null 2>&1 || true
fi

if [ -x /etc/init.d/librespeed-go ]; then
  uci -q set librespeed-go.config.enabled='1'
  uci -q commit librespeed-go 2>/dev/null || true
  /etc/init.d/librespeed-go enable
fi

chmod +x /usr/sbin/wan-src-hash 2>/dev/null || true
chmod +x /usr/sbin/wan-alert /usr/sbin/sys-alert-watch /usr/libexec/wan-alert /etc/init.d/wanalert 2>/dev/null || true
chmod +x /usr/libexec/lede-stamp-reboot /usr/libexec/lede-log-read /usr/sbin/reboot 2>/dev/null || true
chmod +x /usr/libexec/lede-mgmt-bind /etc/hotplug.d/iface/30-lede-mgmt-bind 2>/dev/null || true
chmod +x /usr/libexec/lede-conntrack-tune /etc/init.d/lede-conntrack 2>/dev/null || true
chmod +x /usr/libexec/lede-hwinfo /etc/init.d/lede-hwinfo 2>/dev/null || true
chmod +x /etc/hotplug.d/iface/26-wan-alert 2>/dev/null || true
if [ -x /etc/init.d/wanalert ]; then
  /etc/init.d/wanalert enable
  /etc/init.d/wanalert start >/dev/null 2>&1 || true
fi
chmod +x /etc/hotplug.d/iface/24-wan-fail-dump 2>/dev/null || true
chmod +x /etc/hotplug.d/iface/25-multiwan-main-default 2>/dev/null || true
chmod +x /etc/hotplug.d/iface/27-mwan3-iface-default 2>/dev/null || true
chmod +x /etc/hotplug.d/iface/28-mosdns-rebind 2>/dev/null || true
chmod +x /etc/hotplug.d/iface/29-mwan3-policy-live 2>/dev/null || true
chmod +x /usr/libexec/isp-ip-update /etc/init.d/isp-ip-update 2>/dev/null || true
chmod +x /usr/libexec/mosdns-fix-dns-forward /usr/libexec/mosdns-unify-conf 2>/dev/null || true
[ -x /usr/libexec/mosdns-fix-dns-forward ] && /usr/libexec/mosdns-fix-dns-forward 2>/dev/null || true
[ -x /usr/libexec/mosdns-unify-conf ] && /usr/libexec/mosdns-unify-conf 2>/dev/null || true
mkdir -p /etc/mwan3/isp
# mwan3 stays off until the user adds an enabled interface and starts it.
if [ -x /etc/init.d/mwan3 ]; then
  has_mw=0
  for sid in $(uci -q show mwan3 2>/dev/null | sed -n 's/^mwan3\.\([^.]*\)=interface$/\1/p'); do
    [ "$(uci -q get "mwan3.${sid}.enabled")" = "0" ] && continue
    has_mw=1
    break
  done
  if [ "$has_mw" = 0 ]; then
    /etc/init.d/mwan3 stop >/dev/null 2>&1 || true
    /etc/init.d/mwan3 disable >/dev/null 2>&1 || true
  fi
fi
if [ -f /etc/config/mwan3 ]; then
  # Drop stock samples so Interface / Member / Policy / Rule start empty.
  # Keep globals and the ISP ipset sections we add below.
  while sid=$(uci -q show mwan3 | sed -n "s/^mwan3\\.\\([^=]*\\)=interface$/\\1/p" | head -n 1); do
    [ -n "$sid" ] || break
    uci -q delete "mwan3.$sid" || break
  done
  while sid=$(uci -q show mwan3 | sed -n "s/^mwan3\\.\\([^=]*\\)=member$/\\1/p" | head -n 1); do
    [ -n "$sid" ] || break
    uci -q delete "mwan3.$sid" || break
  done
  while sid=$(uci -q show mwan3 | sed -n "s/^mwan3\\.\\([^=]*\\)=policy$/\\1/p" | head -n 1); do
    [ -n "$sid" ] || break
    uci -q delete "mwan3.$sid" || break
  done
  while sid=$(uci -q show mwan3 | sed -n "s/^mwan3\\.\\([^=]*\\)=rule$/\\1/p" | head -n 1); do
    [ -n "$sid" ] || break
    uci -q delete "mwan3.$sid" || break
  done
  ensure_isp_set() {
    local sid="$1" name="$2" file="$3"
    if [ "$(uci -q get mwan3.${sid})" != "ipset" ]; then
      uci -q set "mwan3.${sid}=ipset"
    fi
    uci -q set "mwan3.${sid}.name=${name}"
    uci -q set "mwan3.${sid}.family=ipv4"
    uci -q set "mwan3.${sid}.loadfile=${file}"
    uci -q set "mwan3.${sid}.enabled=1"
  }
  ensure_isp_set isp_chinanet isp_chinanet /etc/mwan3/isp/chinanet.cidr
  ensure_isp_set isp_unicom isp_unicom /etc/mwan3/isp/unicom.cidr
  ensure_isp_set isp_cmcc isp_cmcc /etc/mwan3/isp/cmcc.cidr
  ensure_isp_set isp_other isp_other /etc/mwan3/isp/other.cidr
  uci -q commit mwan3
fi
# Do not download ISP lists or install helper crons on first boot.
# Single-WAN uses netifd only. mwan3 repair crons attach when an
# enabled mwan3 interface exists (see /lib/functions/lede-mwan3.sh).
if [ -x /etc/init.d/isp-ip-update ]; then
  /etc/init.d/isp-ip-update disable >/dev/null 2>&1 || true
fi
if [ -f /etc/config/isp-ip ]; then
  uci -q set isp-ip.main.auto='0'
  # option -> list so LuCI DynamicList can add/remove URLs
  for key in url_chinanet url_unicom url_cmcc url_other; do
    if uci -q export isp-ip 2>/dev/null | grep -q "option $key "; then
      vals="$(uci -q get isp-ip.main.$key 2>/dev/null || true)"
      uci -q delete "isp-ip.main.$key"
      for u in $vals; do
        [ -n "$u" ] || continue
        uci -q add_list "isp-ip.main.$key=$u"
      done
    fi
  done
  uci -q commit isp-ip
fi
mkdir -p /etc/crontabs
touch /etc/crontabs/root
sed -i '/isp-ip-update/d;/25-multiwan-main-default/d;/27-mwan3-iface-default/d;/29-mwan3-policy-live/d' /etc/crontabs/root 2>/dev/null || true
chmod +x /usr/libexec/rpcd/wanmonitor /usr/libexec/lan-dhcp-apply /usr/libexec/lede-log-read /usr/libexec/lede-rpcd-restart /usr/libexec/packet-cap /etc/init.d/lan-dhcp-exclude 2>/dev/null || true
mkdir -p /overlay/pcap 2>/dev/null || true
for s in alert syslog kernel mosdns; do
  p="$(uci -q get lede-log.$s.path 2>/dev/null || true)"
  [ -n "$p" ] || continue
  p="${p%/}"
  if [ -d "$p" ]; then
    mkdir -p "$p" 2>/dev/null || true
  else
    mkdir -p "${p%/*}" 2>/dev/null || true
  fi
done
if [ "$(uci -q get wanalert.main.log_path)" = "/overlay/sys-alert.log" ]; then
  uci -q set wanalert.main.log_path="$(uci -q get lede-log.alert.path)"
  uci -q commit wanalert
fi
if [ -f /etc/config/lede-log ]; then
  uci -q set lede-log.alert.path="$(uci -q get wanalert.main.log_path)"
  uci -q set lede-log.alert.max_kb="$(uci -q get wanalert.main.log_max_kb)"
  uci -q commit lede-log
fi
if [ -x /etc/init.d/librespeed-go ]; then
  /etc/init.d/librespeed-go enable
  uci -q set librespeed-go.config.enabled='1' 2>/dev/null || true
  uci -q commit librespeed-go 2>/dev/null || true
  /etc/init.d/librespeed-go start >/dev/null 2>&1 || true
fi
if [ -x /etc/init.d/lan-dhcp-exclude ]; then
  /etc/init.d/lan-dhcp-exclude enable
fi
if [ -f /etc/config/mosdns ]; then
  uci -q set mosdns.config.enabled='1'
  uci -q set mosdns.config.configfile='/var/etc/mosdns.yaml'
  uci -q set mosdns.config.listen_port_api='9091'
  uci -q set mosdns.config.custom_local_dns='1'
  uci -q set mosdns.config.dns_follow_wan='1'
  uci -q set mosdns.config.dns_leak='1'
  uci -q set mosdns.config.redirect='1'
  uci -q commit mosdns
fi
if [ ! -f /etc/config/packet_cap ]; then
  touch /etc/config/packet_cap
  uci -q set packet_cap.settings=settings
  uci -q set packet_cap.settings.cap_dir='/overlay/pcap'
  uci -q commit packet_cap
fi
# Loose rp_filter so DNS/data returning on the non-default WAN is not dropped.
[ -f /etc/sysctl.d/12-multiwan-rp-filter.conf ] && sysctl -p /etc/sysctl.d/12-multiwan-rp-filter.conf >/dev/null 2>&1 || true
/etc/init.d/cron restart >/dev/null 2>&1 || true

exit 0
