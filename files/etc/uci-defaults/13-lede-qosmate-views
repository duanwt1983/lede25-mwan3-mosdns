#!/bin/sh
# luci-app-qosmate must install JS under view/qosmate/. A broken Makefile patch
# once flattened them into view/*.js while menus still point at qosmate/*.
dst=/www/luci-static/resources/view/qosmate
src=/www/luci-static/resources/view
mkdir -p "$dst"
for f in settings hfsc cake advanced rules ipsets ratelimits custom_rules connections statistics; do
	[ -f "$src/$f.js" ] && mv "$src/$f.js" "$dst/$f.js"
done
exit 0
