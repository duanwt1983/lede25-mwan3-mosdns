#!/bin/sh
# After luci-app-mosdns has created /etc/config/mosdns.
# Custom yaml is generated by mosdns-mwan (/usr/libexec/mosdns-gen).

[ -f /etc/config/mosdns ] || exit 0

# Factory default is disabled. Keep-config sysupgrade must not turn MosDNS off
# if the restored config already has an enabled flag.
if [ -z "$(uci -q get mosdns.config.enabled 2>/dev/null || true)" ]; then
	uci -q set mosdns.config.enabled='0'
fi
uci -q set mosdns.config.configfile='/var/etc/mosdns.yaml'
uci -q set mosdns.config.listen_port='5335'
uci -q set mosdns.config.listen_port_api='9091'
uci -q set mosdns.config.stats_collector='1'
uci -q set mosdns.config.custom_local_dns='1'
uci -q set mosdns.config.dns_follow_wan='1'
uci -q set mosdns.config.dns_leak='1'
uci -q set mosdns.config.redirect='0'
uci -q set mosdns.config.prefer_ipv4='1'
uci -q set mosdns.config.cache='1'
uci -q set mosdns.config.cache_size='20000'
uci -q set mosdns.config.lazy_cache_ttl='86400'
uci -q set mosdns.config.stats_capacity='2000'

if [ -z "$(uci -q get mosdns.config.local_dns)" ]; then
	uci add_list mosdns.config.local_dns='https://dns.alidns.com/dns-query'
	uci add_list mosdns.config.local_dns='https://doh.pub/dns-query'
fi
if [ -z "$(uci -q get mosdns.config.remote_dns)" ]; then
	uci add_list mosdns.config.remote_dns='tls://8.8.8.8'
	uci add_list mosdns.config.remote_dns='tls://1.1.1.1'
fi

uci commit mosdns
[ -x /usr/libexec/mosdns-gen ] && /usr/libexec/mosdns-gen
[ -x /etc/init.d/mosdns ] && {
	/etc/init.d/mosdns enable >/dev/null 2>&1 || true
	if [ "$(uci -q get mosdns.config.enabled)" = "1" ]; then
		/etc/init.d/mosdns restart >/dev/null 2>&1 || /etc/init.d/mosdns start >/dev/null 2>&1 || true
	else
		/etc/init.d/mosdns stop >/dev/null 2>&1 || true
	fi
}
exit 0
