#!/bin/sh
# Dual PPPoE here shares one peer IP. wan2 was defaultroute=0, so the
# main table only ever had wan1. Disabling wan1 then left LAN forwarding
# on a dead default (or mwan3 still hashing to wan1) while mosdns could
# still bind_to_device out wan2 — DNS works, ping 223.5.5.5 does not.
#
# Keep an onlink default for every UP WAN. Delete main defaults that
# do not belong to an UP WAN (device may still exist after LuCI Stop).
# On ifdown, take that iface out of mwan3 and flush conntrack.
#
# Idle when mwan3 has no enabled interface: single-WAN netifd owns main.

[ -f /lib/functions.sh ] || exit 0
[ -f /lib/functions/lede-mwan3.sh ] && . /lib/functions/lede-mwan3.sh
if ! lede_mwan3_ready 2>/dev/null; then
	lede_mwan3_helper_crons_sync 2>/dev/null || true
	exit 0
fi
lede_mwan3_helper_crons_sync 2>/dev/null || true

if [ -n "$ACTION" ]; then
	case "$ACTION" in
		ifup|ifdown|ifupdate) ;;
		*) exit 0 ;;
	esac
	[ -n "$INTERFACE" ] || exit 0
	[ "$INTERFACE" != "loopback" ] && [ "$INTERFACE" != "lan" ] && [ "$INTERFACE" != "wan6" ] || exit 0
fi

. /lib/functions.sh

LOG_TAG="multiwan-main"
log() { logger -t "$LOG_TAG" "$@"; }

LOCK=/var/run/multiwan-main-default.lock
exec 8>"$LOCK"
flock 8

UP_DEVS=""
UP_GW_LIST=""
LIVE_DEV=""
LIVE_GW=""

_json() { ubus call "network.interface.$1" status 2>/dev/null; }

dev_is_up_wan() {
	local want="$1"
	local d
	for d in $UP_DEVS; do
		[ "$d" = "$want" ] && return 0
	done
	return 1
}

collect_up_dev() {
	local iface="$1"
	local js up device gw enabled family

	if [ "$(uci -q get "mwan3.${iface}")" = "interface" ]; then
		config_get_bool enabled "$iface" enabled 0
		[ "$enabled" = 1 ] || return 0
		config_get family "$iface" family ipv4
		[ "$family" = ipv4 ] || return 0
	fi

	js="$(_json "$iface")"
	[ -n "$js" ] || return 0
	up="$(printf '%s' "$js" | jsonfilter -e '@.up' 2>/dev/null)"
	[ "$up" = "true" ] || return 0

	device="$(printf '%s' "$js" | jsonfilter -e '@.l3_device' 2>/dev/null)"
	[ -n "$device" ] || return 0
	ip link show "$device" >/dev/null 2>&1 || return 0

	gw="$(printf '%s' "$js" | jsonfilter -e '@.route[@.mask=0].nexthop' 2>/dev/null | head -n 1)"
	[ -z "$gw" ] && gw="$(printf '%s' "$js" | jsonfilter -e '@["ipv4-address"][0].ptpaddress' 2>/dev/null | head -n 1)"

	UP_DEVS="$UP_DEVS $device"
	[ -n "$gw" ] && UP_GW_LIST="${UP_GW_LIST}${device} ${gw}
"
	if [ -z "$LIVE_DEV" ]; then
		LIVE_DEV="$device"
		LIVE_GW="$gw"
	fi
}

gw_peer_shared() {
	# Same nexthop on another UP WAN (any mix of shared / unique GWs).
	# Do not use `ip route` dest==gw: DHCP often has no /32 to the peer.
	local gw="$1" keep="$2"
	[ -n "$gw" ] && [ "$gw" != "0.0.0.0" ] && [ -n "$keep" ] || return 1
	printf '%s' "$UP_GW_LIST" | awk -v gw="$gw" -v keep="$keep" '
		NF >= 2 && $2 == gw && $1 != keep { found = 1 }
		END { exit found ? 0 : 1 }
	'
}

install_main_default() {
	local iface="$1"
	local js up device gw metric enabled family

	if [ "$(uci -q get "mwan3.${iface}")" = "interface" ]; then
		config_get_bool enabled "$iface" enabled 0
		[ "$enabled" = 1 ] || return 0
		config_get family "$iface" family ipv4
		[ "$family" = ipv4 ] || return 0
	fi

	js="$(_json "$iface")"
	[ -n "$js" ] || return 0
	up="$(printf '%s' "$js" | jsonfilter -e '@.up' 2>/dev/null)"
	[ "$up" = "true" ] || return 0

	device="$(printf '%s' "$js" | jsonfilter -e '@.l3_device' 2>/dev/null)"
	[ -n "$device" ] || return 0
	ip link show "$device" >/dev/null 2>&1 || return 0

	gw="$(printf '%s' "$js" | jsonfilter -e '@.route[@.mask=0].nexthop' 2>/dev/null | head -n 1)"
	[ -z "$gw" ] && gw="$(printf '%s' "$js" | jsonfilter -e '@["ipv4-address"][0].ptpaddress' 2>/dev/null | head -n 1)"

	metric="$(uci -q get "network.${iface}.metric")"
	[ -n "$metric" ] || metric=0

	if [ -n "$gw" ] && [ "$gw" != "0.0.0.0" ]; then
		if gw_peer_shared "$gw" "$device"; then
			ip -4 route replace default via "$gw" dev "$device" onlink metric "$metric" 2>/dev/null || return 0
		else
			ip -4 route replace default via "$gw" dev "$device" metric "$metric" 2>/dev/null || return 0
		fi
	else
		ip -4 route replace default dev "$device" metric "$metric" 2>/dev/null || return 0
	fi
	log "$iface main default via ${gw:-none} dev $device metric $metric"
}

drop_dead_main_defaults() {
	local line dev

	ip -4 route show default 2>/dev/null | while read -r line; do
		dev="$(printf '%s\n' "$line" | awk '{for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit }}')"
		[ -n "$dev" ] || continue
		dev_is_up_wan "$dev" && continue
		ip -4 route del default dev "$dev" 2>/dev/null && log "drop dead main default dev $dev"
	done
}

# Dead-iface mwan3 marks/rules are handled in 27 (after 25-mwan3 / rtmon).

if [ "$ACTION" = "ifdown" ]; then
	[ -n "$DEVICE" ] && ip -4 route del default dev "$DEVICE" 2>/dev/null && log "ifdown drop default dev $DEVICE"
	if [ -n "$INTERFACE" ] && [ -x /usr/sbin/mwan3 ]; then
		/usr/sbin/mwan3 ifdown "$INTERFACE" >/dev/null 2>&1 || true
		log "mwan3 ifdown $INTERFACE"
	fi
	if [ -x /usr/sbin/conntrack ]; then
		/usr/sbin/conntrack -F >/dev/null 2>&1 || true
	elif [ -x /usr/sbin/mwan3ct ]; then
		/usr/sbin/mwan3ct flush >/dev/null 2>&1 || true
	fi
fi

collect_net_wan() {
	local iface="$1"
	local proto

	config_get proto "$iface" proto
	case "$iface" in
		loopback|lan|wan6|*_6) return 0 ;;
	esac
	case "$proto" in
		pppoe|dhcp|static|pptp|l2tp|3g|ncm|qmi|modemmanager) ;;
		*) return 0 ;;
	esac
	collect_up_dev "$iface"
}

install_net_wan() {
	local iface="$1"
	local proto

	config_get proto "$iface" proto
	case "$iface" in
		loopback|lan|wan6|*_6) return 0 ;;
	esac
	case "$proto" in
		pppoe|dhcp|static|pptp|l2tp|3g|ncm|qmi|modemmanager) ;;
		*) return 0 ;;
	esac
	install_main_default "$iface"
}

config_load network
config_foreach collect_net_wan interface
config_load mwan3
config_foreach collect_up_dev interface
drop_dead_main_defaults
config_load network
config_foreach install_net_wan interface
config_load mwan3
config_foreach install_main_default interface

# mwan3's own ifdown may re-add pref 3001 after we return.
if [ "$ACTION" = "ifdown" ]; then
	( sleep 2; ACTION= /bin/sh /etc/hotplug.d/iface/25-multiwan-main-default ) >/dev/null 2>&1 &
fi
