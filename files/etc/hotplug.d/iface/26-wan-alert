#!/bin/sh
# hotplug-call sources this with ash; do not use a ucode shebang here.

case "$ACTION" in
	ifup|ifdown) ;;
	*) exit 0 ;;
esac

case "$INTERFACE" in
	''|loopback|lan|wan6|*_6) exit 0 ;;
esac

enabled=$(uci -q get "mwan3.${INTERFACE}.enabled")
[ -n "$enabled" ] || exit 0
[ "$enabled" = 0 ] && exit 0
[ "$enabled" = off ] && exit 0

ev=up
[ "$ACTION" = ifdown ] && ev=down
[ -x /usr/libexec/wan-alert ] && /usr/libexec/wan-alert "$ev" "$INTERFACE" >/dev/null 2>&1 &
exit 0
