#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	local en
	en=$(uci -q get lede-center.main.enabled)
	[ "$en" = "1" ] || return 0
	[ -x /usr/bin/frpc ] || {
		logger -t lede-center-frpc "frpc binary missing (install lede-center-frpc)"
		return 1
	}
	/usr/libexec/lede-center-frpc write-config || return 1
	[ -s /var/etc/lede-center-frpc.toml ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/frpc -c /var/etc/lede-center-frpc.toml
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall frpc 2>/dev/null || true
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger lede-center
}
