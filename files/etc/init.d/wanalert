#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	rmdir /tmp/wan-alert.lock 2>/dev/null || true
	procd_open_instance
	procd_set_param command /usr/libexec/wan-alert watch
	procd_set_param respawn 5 10 0
	procd_close_instance
}

stop_service() {
	rmdir /tmp/wan-alert.lock 2>/dev/null || true
	return 0
}
