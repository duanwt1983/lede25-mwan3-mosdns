#!/bin/sh

. /lib/functions.sh

include /lib/upgrade
[ -f /lib/upgrade/lede-flash-dd.sh ] && . /lib/upgrade/lede-flash-dd.sh

v "Performing system upgrade..."
if type 'platform_do_upgrade' >/dev/null 2>/dev/null; then
	platform_do_upgrade "$IMAGE"
else
	default_do_upgrade "$IMAGE"
fi

if [ -n "$UPGRADE_BACKUP" ] && type 'platform_copy_config' >/dev/null 2>/dev/null; then
	platform_copy_config
fi

v "Upgrade completed"
_fw_log_append() {
	[ -w /tmp/lede-fw-flash.log ] && echo "$1" >>/tmp/lede-fw-flash.log
	[ -d /data ] && echo "$1" >>/data/lede-fw-flash.log 2>/dev/null || true
}
_fw_log_append "Upgrade completed $(date -Is 2>/dev/null || date)"

sleep 1

v "Rebooting system..."
v "LEDE: 刷写已完成，3 秒后执行 reboot -f"
_fw_log_append "LEDE: 刷写已完成，3 秒后 reboot -f $(date -Is 2>/dev/null || date)"
sleep 3

# Do not umount -a on x86 with /data and bind mounts (/dat, /tmp/firmware.bin):
# it can hang forever and block reboot. sync + reboot -f is enough here.
sync
reboot -f

sleep 2
echo b 2>/dev/null >/proc/sysrq-trigger
