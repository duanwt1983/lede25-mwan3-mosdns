{
	"luci-mwan3-isp": {
		"description": "Update China ISP CIDR lists for mwan3",
		"read": {
			"ubus": {
				"luci.ispip": [ "get_update_log" ]
			},
			"uci": [ "isp-ip", "mwan3" ],
			"file": {
				"/usr/libexec/isp-ip-update": [ "exec" ],
				"/bin/sh": [ "exec" ],
				"/etc/init.d/mwan3": [ "exec" ],
				"/usr/libexec/lede-mwan3-setup": [ "exec" ],
				"/usr/libexec/lede-mwan3-setup *": [ "exec" ],
				"/var/log/isp-ip-update.log": [ "read" ],
				"/var/run/isp-ip-update.status": [ "read" ],
				"/etc/mwan3/isp": [ "list" ],
				"/etc/mwan3/isp/*": [ "read" ]
			}
		},
		"write": {
			"ubus": {
				"luci.ispip": [ "start_update" ]
			},
			"uci": [ "isp-ip", "mwan3" ],
			"file": {
				"/usr/libexec/isp-ip-update": [ "exec" ],
				"/bin/sh": [ "exec" ],
				"/etc/init.d/mwan3": [ "exec" ],
				"/usr/libexec/lede-mwan3-setup": [ "exec" ],
				"/usr/libexec/lede-mwan3-setup *": [ "exec" ]
			}
		}
	}
}
