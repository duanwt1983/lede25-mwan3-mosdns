{
	"luci-mod-system-flash": {
		"description": "Grant access to flash operations and LEDE component packs",
		"read": {
			"cgi-io": [ "backup", "download" ],
			"file": {
				"/dev/mtdblock[0-9]*": [ "read" ],
				"/etc/sysupgrade.conf": [ "read" ],
				"/etc/lede-component-state.json": [ "read" ],
				"/lib/upgrade/platform.sh": [ "list" ],
				"/proc/[0-9]*/mounts": [ "read" ],
				"/proc/mounts": [ "read" ],
				"/proc/mtd": [ "read" ],
				"/proc/partitions": [ "read" ],
				"/proc/sys/kernel/hostname": [ "read" ],
				"/sbin/sysupgrade --list-backup": [ "exec" ],
				"/tmp/lede-component-apply.log": [ "read" ]
			},
			"ubus": {
				"file": [ "exec", "read", "stat" ],
				"lede-component": [ "status", "list_packs" ]
			}
		},
		"write": {
			"cgi-io": [ "upload" ],
			"file": {
				"/bin/tar -tzf /tmp/backup.tar.gz": [ "exec" ],
				"/etc/sysupgrade.conf": [ "write" ],
				"/sbin/firstboot -r -y": [ "exec" ],
				"/sbin/reboot": [ "exec" ],
				"/sbin/sysupgrade --force /data/firmware.bin": [ "exec" ],
				"/sbin/sysupgrade -n --force /data/firmware.bin": [ "exec" ],
				"/sbin/sysupgrade --force -k /data/firmware.bin": [ "exec" ],
				"/sbin/sysupgrade --force -u /data/firmware.bin": [ "exec" ],
				"/sbin/sysupgrade --force -u -k /data/firmware.bin": [ "exec" ],
				"/sbin/sysupgrade -n /data/firmware.bin": [ "exec" ],
				"/sbin/sysupgrade -k /data/firmware.bin": [ "exec" ],
				"/sbin/sysupgrade -u /data/firmware.bin": [ "exec" ],
				"/sbin/sysupgrade -u -k /data/firmware.bin": [ "exec" ],
				"/sbin/sysupgrade --restore-backup /tmp/backup.tar.gz": [ "exec" ],
				"/sbin/sysupgrade --test /data/firmware.bin": [ "exec" ],
				"/sbin/sysupgrade /data/firmware.bin": [ "exec" ],
				"/sbin/sysupgrade --test /tmp/firmware.bin": [ "exec" ],
				"/sbin/sysupgrade /tmp/firmware.bin": [ "exec" ],
				"/sbin/sysupgrade -n /tmp/firmware.bin": [ "exec" ],
				"/sbin/sysupgrade --force /tmp/firmware.bin": [ "exec" ],
				"/sbin/sysupgrade -n --force /tmp/firmware.bin": [ "exec" ],
				"/tmp/firmware.bin": [ "read", "write", "list" ],
				"/tmp/backup.tar.gz": [ "write" ],
				"/data/firmware.bin": [ "write" ],
				"/usr/libexec/lede-component-apply": [ "exec" ],
				"/usr/libexec/lede-firmware-prepare.sh": [ "exec" ],
				"/usr/libexec/lede-firmware-mark-flash.sh": [ "exec" ],
				"/usr/libexec/lede-firmware-delete.sh": [ "exec" ],
				"/usr/libexec/lede-firmware-progress.sh": [ "exec" ],
				"/usr/libexec/lede-firmware-upload-env.sh": [ "exec" ],
				"/usr/libexec/lede-firmware-upload-check.sh": [ "exec" ],
				"/tmp/sysupgrade.log": [ "read" ],
				"/tmp/lede-fw-flash.log": [ "read" ],
				"/etc/lede-fw-last-flash-success": [ "read" ],
				"/etc/openwrt_release": [ "read" ],
				"/tmp/lede-overlay.tar.gz": [ "write", "read" ],
				"/tmp/lede-component-dl.tar.gz": [ "write", "read" ],
				"/data": [ "list" ],
				"/data/*": [ "read", "write", "list" ]
			},
			"ubus": {
				"file": [ "exec", "remove", "write" ],
				"system": [ "validate_firmware_image" ],
				"lede-component": [ "apply_url", "apply_file" ]
			}
		}
	}
}
