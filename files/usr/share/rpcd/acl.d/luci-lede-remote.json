{
	"luci-lede-remote": {
		"description": "Remote management: WAN HTTPS and regional center frpc",
		"read": {
			"uci": [ "lede-remote", "lede-center" ],
			"file": {
				"/usr/libexec/lede-wan-https": [ "exec" ],
				"/usr/libexec/lede-center-frpc": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "lede-remote", "lede-center" ],
			"file": {
				"/usr/libexec/lede-wan-https": [ "exec" ],
				"/usr/libexec/lede-center-frpc": [ "exec" ]
			}
		}
	}
}
