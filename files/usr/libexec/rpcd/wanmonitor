#!/usr/bin/ucode
'use strict';

import { cursor } from 'uci';
import { readfile, writefile, popen, stat } from 'fs';
import * as ubus from 'ubus';
import {
	trim, as_bool, as_list, now_fmt, max_temp_c, cpu_pct, mem_percent, bytes_of, disks_overview,
	load_rate_win
} from '/usr/share/ucode/lede-metrics.uc';
import {
	bandix_load, bandix_build_maps, bandix_iface_rates, bandix_resolve_iface_rates,
	bandix_clients_list, bandix_wan_rates, bandix_rate_meta
} from '/usr/share/ucode/lede-bandix.uc';

function ubus_close(u) {
	if (u == null)
		return;
	try { u.disconnect(); } catch (e) {}
}

function iface_status(u, name) {
	if (u == null)
		return {};
	try {
		return u.call('network.interface.' + name, 'status') || {};
	} catch (e) {
		return {};
	}
}

function mwan3_ifaces(u) {
	if (u == null)
		return {};
	try {
		let mj = u.call('mwan3', 'status');
		if (mj && type(mj.interfaces) == 'object')
			return mj.interfaces;
	} catch (e) {}
	return {};
}

function wan_health(name, up, ip, ifaces) {
	let d = ifaces[name];
	let st = d && d.status ? d.status : '';
	if (st == 'online')
		return { health: 'ok', text: '正常' };
	if (st == 'offline')
		return { health: 'bad', text: '异常' };
	if (st == 'disabled')
		return { health: 'warn', text: '未启用' };
	if (st == 'notracking') {
		if (up && ip)
			return { health: 'ok', text: '正常' };
		if (up)
			return { health: 'warn', text: '无地址' };
		return { health: 'bad', text: '掉线' };
	}
	if (!up)
		return { health: 'bad', text: '掉线' };
	if (!ip)
		return { health: 'warn', text: '无地址' };
	return { health: 'ok', text: '正常' };
}

function is_ipv4(s) {
	return match(`${s}`, /^[0-9]{1,3}(\.[0-9]{1,3}){3}$/) != null;
}

function ping_host_for(mw, ctx, name) {
	let d = mw[name];
	if (d && type(d.track_ip) == 'array') {
		for (let t in d.track_ip)
			if (t && t.status == 'up' && is_ipv4(t.ip))
				return t.ip;
		for (let t in d.track_ip)
			if (t && t.status != 'skipped' && is_ipv4(t.ip))
				return t.ip;
		for (let t in d.track_ip)
			if (t && is_ipv4(t.ip))
				return t.ip;
	}
	let list = ctx.get('mwan3', name, 'track_ip');
	if (type(list) == 'array') {
		for (let ip in list)
			if (is_ipv4(ip))
				return ip;
	} else if (is_ipv4(list))
		return list;
	return '223.5.5.5';
}

function lat_tag(name) {
	return replace(`${name}`, /[^A-Za-z0-9_]/g, '_');
}

function kick_wan_ping(name, dev, host) {
	if (!dev || match(dev, /[^A-Za-z0-9._-]/) || !is_ipv4(host))
		return;
	let tag = lat_tag(name);
	let stamp = '/tmp/lede-wan-lat-' + tag + '.t';
	let now = time();
	let last = +trim(readfile(stamp) || '0');
	if (last > 0 && now - last < 8)
		return;
	writefile(stamp, now + '\n');
	let out = '/tmp/lede-wan-lat-' + tag;
	system(sprintf("(ping -c 1 -W 1 -I %s %s 2>/dev/null | awk -F'time=' '/time=/{gsub(/ ms/,\"\"); print $2; exit}' > %s.tmp && mv %s.tmp %s) >/dev/null 2>&1 &",
		dev, host, out, out, out));
}

function wan_latency(mw, ctx, name, dev, up) {
	if (!up)
		return '';
	let host = ping_host_for(mw, ctx, name);
	kick_wan_ping(name, dev, host);
	let tag = lat_tag(name);
	let val = trim(readfile('/tmp/lede-wan-lat-' + tag) || '');
	if (match(val, /^[0-9]+(\.[0-9]+)?$/))
		return val;
	return '';
}

function sys_speed(dev) {
	if (!dev || match(dev, /[^A-Za-z0-9_.-]/))
		return 0;
	let n = +trim(readfile('/sys/class/net/' + dev + '/speed') || '');
	if (n > 0 && n < 200000)
		return int(n);
	return 0;
}

function walk_speed(dev, depth) {
	let n = sys_speed(dev);
	if (n)
		return n;
	if (depth > 3 || !dev || match(dev, /[^A-Za-z0-9_.-]/))
		return 0;

	let p = popen(sprintf('ls -1 /sys/class/net/%s/lower_* 2>/dev/null', dev), 'r');
	if (p) {
		let text = p.read('all') || '';
		p.close();
		for (let line in split(text, '\n')) {
			let bn = trim(line);
			if (!bn || index(bn, '*') >= 0)
				continue;
			let parts = split(bn, '/');
			bn = parts[length(parts) - 1];
			if (index(bn, 'lower_') == 0)
				bn = substr(bn, 6);
			n = walk_speed(bn, depth + 1);
			if (n)
				return n;
		}
	}

	p = popen(sprintf('ls /sys/class/net/%s/brif 2>/dev/null', dev), 'r');
	if (!p)
		return 0;
	let text = p.read('all') || '';
	p.close();
	for (let name in split(text, '\n')) {
		name = trim(name);
		if (!name)
			continue;
		n = walk_speed(name, depth + 1);
		if (n)
			return n;
	}
	return 0;
}

function link_mbps(dev) {
	if (!dev)
		return 0;
	let cache = {};
	try { cache = json(readfile('/tmp/lede-link-mbps.json') || '{}') || {}; } catch (e) { cache = {}; }
	if (type(cache) != 'object')
		cache = {};
	let hit = cache[dev];
	if (hit && type(hit) == 'object' && time() - +(hit.t || 0) < 60)
		return +(hit.n || 0);
	let n = walk_speed(dev, 0);
	cache[dev] = { t: time(), n };
	try { writefile('/tmp/lede-link-mbps.json', sprintf('%J', cache)); } catch (e) {}
	return n;
}

function skip_iface(sid) {
	if (sid == null || sid == '')
		return true;
	if (sid == 'loopback' || sid == 'lan' || sid == 'wan6')
		return true;
	if (match(sid, /_6$/) || match(sid, /^@/))
		return true;
	return false;
}

function wan_like_proto(proto) {
	return proto == 'pppoe' || proto == 'dhcp' || proto == 'pptp' || proto == 'l2tp' ||
		proto == 'pppoa' || proto == '3g' || proto == 'ncm' || proto == 'qmi' ||
		proto == 'modemmanager' || proto == 'mbim' || proto == 'wwan' ||
		proto == 'ppp' || proto == 'dslite' || proto == 'vti' || proto == 'gre';
}

function add_wan(names, seen, sid) {
	if (skip_iface(sid) || seen[sid])
		return;
	seen[sid] = true;
	push(names, sid);
}

/* Always from 网络 → 接口 / 防火墙 WAN 区。不依赖 mwan3 是否启用。 */
function collect_wan_names(ctx, u) {
	let names = [];
	let seen = {};

	ctx.foreach('firewall', 'zone', (z) => {
		if (z.name != 'wan')
			return;
		for (let n in as_list(z.network))
			add_wan(names, seen, n);
	});

	ctx.foreach('network', 'interface', (s) => {
		let sid = s['.name'];
		if (skip_iface(sid))
			return;
		if (match(sid, /^wan/) || wan_like_proto(s.proto))
			add_wan(names, seen, sid);
	});

	try {
		if (u == null)
			return names;
		let dump = u.call('network.interface', 'dump');
		if (dump && type(dump.interface) == 'array') {
			for (let it in dump.interface) {
				let n = it.interface;
				if (skip_iface(n) || seen[n])
					continue;
				let routes = it.route;
				if (type(routes) != 'array')
					continue;
				for (let r in routes) {
					if (r && (r.target == '0.0.0.0' || r.target == '::')) {
						add_wan(names, seen, n);
						break;
					}
				}
			}
		}
	} catch (e) {}

	return names;
}

function rate_hist() {
	let req = {};
	try { req = json(readfile('/dev/stdin') || '{}'); } catch (e) { req = {}; }
	let win = +(req.window || 300);
	print(sprintf('%J\n', load_rate_win(win)));
}

function pulse() {
	let bj = bandix_load(true);
	let bmaps = bandix_build_maps(bj);
	let up = split(trim(readfile('/proc/uptime') || '0'), /[ \t]+/)[0];
	let clock = now_fmt();
	let clock_hms = '';
	let clock_day = '';
	let hm = match(clock, /^([0-9-]+) ([0-9:]+)$/);
	if (hm) {
		clock_day = hm[1];
		clock_hms = hm[2];
	}
	let la = split(trim(readfile('/proc/loadavg') || '0.00 0.00 0.00'), /[ \t]+/);
	let conn = +(trim(readfile('/proc/sys/net/netfilter/nf_conntrack_count') || '0'));
	let conn_max = +(trim(readfile('/proc/sys/net/netfilter/nf_conntrack_max') || '0'));
	let lan_dev = 'br-lan';
	let lan_ip = '';
	if (bj && type(bj.data.interfaces) == 'array') {
		for (let iface in bj.data.interfaces) {
			if (iface.ifname == 'br-lan' || iface.zone == 'lan') {
				if (iface.ifname)
					lan_dev = iface.ifname;
				break;
			}
		}
	}
	let lan_rates = bandix_iface_rates(bmaps, lan_dev);
	let lan = {
		device: lan_dev,
		down_bps: lan_rates.down_bps,
		up_bps: lan_rates.up_bps,
		rx_bytes: 0,
		tx_bytes: 0
	};
	let cl = bandix_clients_list(bj, lan_ip);
	let clients = cl.clients;
	let wan_rates = {};
	if (bj) {
		let u = null;
		try { u = ubus.connect(); } catch (e) { u = null; }
		let ctx = cursor();
		ctx.load('network');
		ctx.load('firewall');
		let names = collect_wan_names(ctx, u);
		let wans = [];
		for (let name in names) {
			let st = iface_status(u, name);
			let dev = st.l3_device || ctx.get('network', name, 'device') || '';
			push(wans, {
				name,
				device: dev,
				up: (st.up == true || st.up == 1)
			});
		}
		wan_rates = bandix_wan_rates(bmaps, wans);
		ubus_close(u);
	}
	print(sprintf('%J\n', {
		ts: int(+up * 1000),
		lan,
		clients,
		wan_rates,
		rate_source: 'bandix',
		clients_sum: { online: cl.online, leases: cl.leases },
		sys: {
			clock, clock_hms, clock_day,
			load_1: la[0] || '0.00',
			load_5: la[1] || '0.00',
			load_15: la[2] || '0.00',
			temp_c: max_temp_c(),
			cpu_pct: cpu_pct(),
			mem_pct: mem_percent(),
			conn, conn_max,
			uptime: int(up)
		}
	}));
}

function snapshot() {
	let ctx = cursor();
	ctx.load('network');
	ctx.load('firewall');
	try { ctx.load('mwan3'); } catch (e) {}
	try { ctx.load('dhcp'); } catch (e) {}
	let u = null;
	try { u = ubus.connect(); } catch (e) { u = null; }
	let names = collect_wan_names(ctx, u);
	let mw = mwan3_ifaces(u);

	let wans = [];
	for (let name in names) {
		let st = iface_status(u, name);
		let dev = st.l3_device || ctx.get('network', name, 'device') || '';
		let phy = st.device || ctx.get('network', name, 'device') || '';
		let ip = '';
		let a4 = st['ipv4-address'];
		if (type(a4) == 'array' && a4[0] && a4[0].address)
			ip = a4[0].address;
		let up = (st.up == true || st.up == 1);
		let b = bytes_of(dev);
		let h = wan_health(name, up, ip, mw);
		push(wans, {
			name, device: dev, ipv4: ip,
			proto: ctx.get('network', name, 'proto') || '',
			ifuptime: +(st.uptime || 0),
			latency: wan_latency(mw, ctx, name, dev, up),
			up: up,
			speed: link_mbps(dev) || link_mbps(phy),
			bw_down: +(ctx.get('network', name, 'lede_bw_down') || 0),
			bw_up: +(ctx.get('network', name, 'lede_bw_up') || 0),
			health: h.health,
			health_text: h.text,
			rx_bytes: b.rx,
			tx_bytes: b.tx
		});
	}

	let lst = iface_status(u, 'lan');
	let lan_dev = lst.l3_device || 'br-lan';
	let lan_ip = '';
	let la4 = lst['ipv4-address'];
	if (type(la4) == 'array' && la4[0] && la4[0].address)
		lan_ip = la4[0].address;
	let lb = bytes_of(lan_dev);
	let now = time();

	let bj = bandix_load(false);
	let bmaps = bandix_build_maps(bj);
	let lan_rates = bandix_iface_rates(bmaps, lan_dev);
	let cl = bandix_clients_list(bj, lan_ip);
	let clients = cl.clients;
	let online = cl.online;
	let leases = cl.leases;
	for (let i = 0; i < length(wans); i++) {
		let dev = wans[i].device || '';
		let name = wans[i].name || '';
		let wr = bandix_resolve_iface_rates(bmaps, dev || name, [ name, dev ]);
		wans[i].down_bps = wr.down_bps;
		wans[i].up_bps = wr.up_bps;
	}

	let conn = +(trim(readfile('/proc/sys/net/netfilter/nf_conntrack_count') || '0'));
	let conn_max = +(trim(readfile('/proc/sys/net/netfilter/nf_conntrack_max') || '0'));
	let up = split(trim(readfile('/proc/uptime') || '0'), /[ \t]+/)[0];
	let clock = now_fmt();
	let clock_hms = '';
	let clock_day = '';
	let hm = match(clock, /^([0-9-]+) ([0-9:]+)$/);
	if (hm) {
		clock_day = hm[1];
		clock_hms = hm[2];
	}
	let la = split(trim(readfile('/proc/loadavg') || '0.00 0.00 0.00'), /[ \t]+/);

	print(sprintf('%J\n', {
		ts: int(+up * 1000),
		wans,
		lan: {
			device: lan_dev, ipv4: lan_ip,
			rx_bytes: lb.rx, tx_bytes: lb.tx, speed: link_mbps(lan_dev),
			down_bps: lan_rates.down_bps, up_bps: lan_rates.up_bps
		},
		clients,
		clients_sum: { online, leases },
		sys: {
			clock, clock_hms, clock_day,
			load_1: la[0] || '0.00',
			load_5: la[1] || '0.00',
			load_15: la[2] || '0.00',
			temp_c: max_temp_c(),
			cpu_pct: cpu_pct(),
			mem_pct: mem_percent(),
			conn, conn_max,
			conn_tcp: 0,
			conn_udp: 0,
			conn_icmp: 0,
			uptime: int(up)
		},
		disks: [],
		rates: bandix_rate_meta(bj, wans, lan_dev, clients),
		rate_source: 'bandix'
	}));
	ubus_close(u);
}

function layout_path() {
	return '/etc/lede-topo.json';
}

function layout_get() {
	let data = {};
	let raw = readfile(layout_path()) || '';
	if (raw != '') {
		try {
			data = json(raw);
		} catch (e) {
			data = {};
		}
	}
	if (type(data) != 'object')
		data = {};
	print(sprintf('%J\n', data));
}

function is_wan_name(ctx, name) {
	if (type(name) != 'string' || name == '' || match(name, /[^A-Za-z0-9_]/))
		return false;
	if (name == 'lan' || name == 'loopback' || name == 'wan6')
		return false;
	if (ctx.get('mwan3', name) != null)
		return true;
	let proto = ctx.get('network', name, 'proto');
	if (proto == 'pppoe' || proto == 'pptp' || proto == 'l2tp' || proto == '3g' || proto == 'qmi' || proto == 'ncm')
		return true;
	if (match(name, /^[Ww]an/))
		return true;
	return false;
}

function wan_restart() {
	let req = {};
	try {
		req = json(readfile('/dev/stdin') || '{}');
	} catch (e) {
		req = {};
	}
	let name = trim(req.name || '');
	let ctx = cursor();
	ctx.load('network');
	ctx.load('mwan3');
	if (!is_wan_name(ctx, name)) {
		print('{ "ok": false, "error": "not a wan" }\n');
		return;
	}
	system(sprintf('(ifdown %s; sleep 2; ifup %s) >/dev/null 2>&1 &', name, name));
	print('{ "ok": true, "name": "' + name + '" }\n');
}

function gateway_reboot() {
	let src = 'overview';
	try {
		let req = json(readfile('/dev/stdin') || '{}');
		if (type(req) == 'object' && req.source != null) {
			let s = replace('' + req.source, /[^a-zA-Z0-9_-]/g, '');
			if (s != '')
				src = s;
		}
	} catch (e) {}
	system("/usr/libexec/lede-stamp-reboot 'user-" + src + ":用户点击重启' '" + src + "' >/dev/null 2>&1");
	system('(sleep 1; reboot) >/dev/null 2>&1 &');
	print('{ "ok": true }\n');
}

function layout_set() {
	let req = {};
	try {
		req = json(readfile('/dev/stdin') || '{}');
	} catch (e) {
		req = {};
	}
	let layout = req;
	if (type(req) == 'object' && req.layout != null)
		layout = req.layout;
	if (type(layout) != 'object')
		layout = {};
	layout.saved = 1;
	let body = sprintf('%J', layout);
	if (length(body) > 262144) {
		print('{ "ok": false, "error": "too large" }\n');
		return;
	}
	writefile(layout_path(), body);
	print('{ "ok": true }\n');
}

function hwinfo_path() {
	if (stat('/tmp/lede-hwinfo.json') != null)
		return '/tmp/lede-hwinfo.json';
	if (stat('/data/metrics/lede-hwinfo.json') != null)
		return '/data/metrics/lede-hwinfo.json';
	return '/tmp/lede-hwinfo.json';
}

function emit_hwinfo() {
	let path = hwinfo_path();
	let raw = readfile(path) || '';
	if (raw == '') {
		system('/usr/libexec/lede-hwinfo >/dev/null 2>&1');
		raw = readfile('/tmp/lede-hwinfo.json') || '{}';
	}
	if (!match(raw, /\n$/))
		raw += '\n';
	print(raw);
}

function hwinfo_refresh() {
	system('/usr/libexec/lede-hwinfo >/dev/null 2>&1');
	emit_hwinfo();
}

let cmd = ARGV[0];
if (cmd == 'list') {
	print('{ "snapshot": {}, "pulse": {}, "rate_hist": { "window": 300 }, "layout_get": {}, "layout_set": { "layout": {} }, "wan_restart": { "name": "" }, "gateway_reboot": { "source": "" }, "hwinfo": {}, "hwinfo_refresh": {} }\n');
} else if (cmd == 'call' && ARGV[1] == 'snapshot') {
	snapshot();
} else if (cmd == 'call' && ARGV[1] == 'pulse') {
	pulse();
} else if (cmd == 'call' && ARGV[1] == 'rate_hist') {
	rate_hist();
} else if (cmd == 'call' && ARGV[1] == 'layout_get') {
	layout_get();
} else if (cmd == 'call' && ARGV[1] == 'layout_set') {
	layout_set();
} else if (cmd == 'call' && ARGV[1] == 'wan_restart') {
	wan_restart();
} else if (cmd == 'call' && ARGV[1] == 'gateway_reboot') {
	gateway_reboot();
} else if (cmd == 'call' && ARGV[1] == 'hwinfo') {
	emit_hwinfo();
} else if (cmd == 'call' && ARGV[1] == 'hwinfo_refresh') {
	hwinfo_refresh();
}
