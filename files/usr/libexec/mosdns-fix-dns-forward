#!/bin/sh
# Patch stock luci-app-mosdns init for this firmware (YAML generator, dhcp forward, procd).
f=/etc/init.d/mosdns
[ -f "$f" ] || exit 0

if ! grep -q 'config_foreach get_config "config"' "$f"; then
	awk '
		/config_foreach get_config "mosdns"/ {
			print
			print "	config_foreach get_config \"config\""
			next
		}
		{ print }
	' "$f" > "$f.new" && mv "$f.new" "$f"
fi

if ! awk '/^stop_service\(\)/{f=1} f&&/config_foreach get_config "config"/{c=1} END{exit !f||c}' "$f"; then
	awk '
		/^stop_service\(\) \{/ { in_stop=1 }
		in_stop && /config_foreach get_config "mosdns"/ {
			print
			print "	config_foreach get_config \"config\""
			in_stop=0
			next
		}
		{ print }
	' "$f" > "$f.new" && mv "$f.new" "$f"
fi

if grep -q '127.0.0.1#$(awk' "$f"; then
	awk '
		index($0, "127.0.0.1#$(awk") {
			print "		uci add_list dhcp.@dnsmasq[0].server=\"127.0.0.1#${listen_port:-5335}\""
			next
		}
		{ print }
	' "$f" > "$f.new" && mv "$f.new" "$f"
fi

if grep -q 'uci add_list dhcp.@dnsmasq\[0\].server="127.0.0.1#${listen_port:-5335}"' "$f" && \
	grep -c 'uci add_list dhcp.@dnsmasq\[0\].server="127.0.0.1#${listen_port:-5335}"' "$f" | grep -q '^2$'; then
	awk '
		/uci add_list dhcp.@dnsmasq\[0\].server="127.0.0.1#\$\{listen_port:-5335\}"/ {
			if (!seen++) { print; next }
		}
		{ print }
	' "$f" > "$f.new" && mv "$f.new" "$f"
fi

if ! grep -q 'do not use killall mosdns' "$f"; then
	awk '
		/^[[:space:]]*procd_open_instance mosdns/ && !done {
			print "\t# Ensure stale daemon does not block listen ports (do not use killall mosdns: it matches init script too)."
			print "\tfor _p in $(pidof mosdns); do"
			print "\t\t[ -x \"/proc/${_p}/exe\" ] || continue"
			print "\t\t[ \"$(readlink \"/proc/${_p}/exe\" 2>/dev/null)\" = \"/usr/bin/mosdns\" ] && kill \"${_p}\" 2>/dev/null"
			print "\tdone"
			print "\tsleep 1"
			print ""
			done=1
		}
		{ print }
	' "$f" > "$f.new" && mv "$f.new" "$f"
fi

chmod 755 "$f"
exit 0
