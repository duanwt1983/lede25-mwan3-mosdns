#!/usr/bin/ucode
'use strict';

import { cursor } from 'uci';
import { readfile, writefile } from 'fs';
import * as ubus from 'ubus';
import {
	track_ip_for, wan_probe_ok, wait_wan_probe
} from '/usr/share/ucode/lede-wan-probe.uc';
import { as_bool } from '/usr/share/ucode/lede-metrics.uc';

const ST = '/tmp/lede-autofix.json';

function trim(s) {
	return replace(`${s || ''}`, /^\s+|\s+$/g, '');
}

function load_st() {
	try {
		return json(readfile(ST) || '{}') || {};
	} catch (e) {
		return {};
	}
}

function mark(key) {
	let st = load_st();
	st[key] = time();
	writefile(ST, sprintf('%J\n', st));
}

function cooled(key, sec) {
	let last = +load_st()[key];
	return last > 0 && (time() - last) < sec;
}

function wan_fail_key(iface) {
	return 'fail-down-' + iface;
}

function wan_mark_fail(iface) {
	mark(wan_fail_key(iface));
}

function phy_link_up(dev) {
	if (dev == '' || !match(dev, /^[A-Za-z0-9_.-]+$/))
		return;
	system(sprintf("ip link set dev '%s' up >/dev/null 2>&1", dev));
}

function bounce_iface(name, dev) {
	if (!match(name, /^[A-Za-z0-9_]+$/))
		return false;
	phy_link_up(dev || '');
	system(sprintf("ifup '%s' >/dev/null 2>&1", name));
	return true;
}

function wan_fix_ok(ctx, iface) {
	if (!as_bool(ctx.get('wanalert', 'main', 'autofix_wan'), true))
		return false;
	if (ctx.get('wanalert', 'main', 'wfix_' + iface) == '0')
		return false;
	return true;
}

function report(key, ok, iface, log_detail) {
	let outcome = ok ? '成功' : '失败';
	writefile('/tmp/lede-fix-report.json', sprintf('%J\n', {
		key,
		kind: 'wan_bounce',
		iface,
		level: ok ? '一般' : '中等',
		cat: '系统',
		title: '自动维护',
		msg: sprintf('%s 断网后重启网卡【%s】', iface, outcome),
		detail: log_detail || ''
	}));
	mark('reported-' + key);
	system("/usr/libexec/wan-alert fix-done >/dev/null 2>&1");
}

let key = trim(ARGV[0] || '');
if (key == '' || !match(key, /^down-[A-Za-z0-9_]+$/))
	exit(0);

let ctx = cursor();
try { ctx.load('wanalert'); ctx.load('network'); ctx.load('mwan3'); } catch (e) {}
if (!as_bool(ctx.get('wanalert', 'main', 'autofix'), false))
	exit(0);
if (!as_bool(ctx.get('wanalert', 'main', 'autofix_wan'), true))
	exit(0);

let iface = replace(key, /^down-/, '');
let lock = '/tmp/lede-autofix-' + iface + '.lock';
if (system(sprintf('mkdir %s 2>/dev/null', lock)) != 0)
	exit(0);

let ufix = null;
try { ufix = ubus.connect(); } catch (e) { ufix = null; }
if (!wan_fix_ok(ctx, iface)) {
	system(sprintf('rmdir %s 2>/dev/null', lock));
	exit(0);
}

let cdn = +ctx.get('wanalert', 'main', 'autofix_cooldown') || 600;
if (cdn < 120)
	cdn = 120;
let host = track_ip_for(ctx, iface);
let phy = ctx.get('network', iface, 'device') || '';

if (wan_probe_ok(ctx, ufix, iface)) {
	if (!cooled('reported-' + key, cdn))
		report(key, true, iface, sprintf('探测 %s 已通，未执行 ifup。', host));
	system(sprintf('rmdir %s 2>/dev/null', lock));
	try { ufix.disconnect(); } catch (e) {}
	exit(0);
}

if (cooled(wan_fail_key(iface), 90) || cooled(key, cdn)) {
	if (!cooled('reported-' + key, cdn))
		report(key, false, iface, sprintf('仍在处理间隔内，外网探测 %s 未通。', host));
	system(sprintf('rmdir %s 2>/dev/null', lock));
	try { ufix.disconnect(); } catch (e) {}
	exit(0);
}

if (!bounce_iface(iface, phy)) {
	wan_mark_fail(iface);
	report(key, false, iface, '接口名不合法，未执行 ifup。');
	system(sprintf('rmdir %s 2>/dev/null', lock));
	try { ufix.disconnect(); } catch (e) {}
	exit(0);
}

let ok = wait_wan_probe(ctx, ufix, iface, 50);
if (ok)
	mark(key);
else
	wan_mark_fail(iface);
report(key, ok, iface,
	ok ? sprintf('已执行 ifup，外网探测 %s 正常。', host)
	   : sprintf('已执行 ifup，但外网探测 %s 仍失败。', host));
system(sprintf('rmdir %s 2>/dev/null', lock));
try { ufix.disconnect(); } catch (e) {}
exit(0);
