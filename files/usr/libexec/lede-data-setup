#!/bin/sh
# One-shot first-boot initializer: grow prebuilt LEDEDATA to disk end, format
# if needed, write fstab, mount /data. Runs once, then retires itself.
# Legacy images without LEDEDATA still fall back to creating a trailing partition.
# Never touches disks other than the one hosting the running root filesystem.

MARKER=/data/.lede-data
INIT_DONE=/etc/.lede-data-init.done
MIN_MIB=1024
LABEL=LEDEDATA
LOG=/tmp/lede-data-setup.log
RETIRED=0

log() {
	echo "$(date '+%F %T') $*" >> "$LOG"
	logger -t lede-data "$*"
}

data_mounted() {
	grep -q ' /data ' /proc/mounts
}

enable_data_automount() {
	[ -x /etc/init.d/fstab ] && /etc/init.d/fstab enable
}

retire_data_init() {
	[ "$RETIRED" = 1 ] && return 0
	RETIRED=1
	log "retiring one-time /data initializer"
	touch "$INIT_DONE" 2>/dev/null || true
	/etc/init.d/lede-data disable 2>/dev/null || true
	rm -f /etc/rc.d/S??lede-data /etc/rc.d/K??lede-data 2>/dev/null || true
	rm -f /etc/init.d/lede-data 2>/dev/null || true
	rm -f /usr/libexec/lede-data-setup 2>/dev/null || true
}

seed_and_bind() {
	local ov="$1" dt="$2" f bn
	[ -n "$ov" ] && [ -n "$dt" ] || return 0
	mkdir -p "$dt" "$ov"
	for f in "$ov"/* "$ov"/.[!.]*; do
		[ -e "$f" ] || continue
		bn=$(basename "$f")
		[ -e "$dt/$bn" ] || cp -a "$f" "$dt/$bn" 2>/dev/null || true
	done
	if ! grep -q " $ov " /proc/mounts; then
		mount --bind "$dt" "$ov" 2>/dev/null || true
	fi
}

ensure_dirs() {
	enable_data_mount_service
	mkdir -p \
		/data/logs/alert \
		/data/logs/syslog \
		/data/logs/kernel \
		/data/logs/mosdns \
		/data/mosdns/cache \
		/data/mosdns/adlist \
		/data/geodata \
		/data/passwall/rules \
		/data/pcap \
		/data/metrics \
		/data/share
	for f in /etc/mosdns/cache.dump /etc/mosdns/cache_wan*.dump /etc/mosdns/stats.dump; do
		[ -f "$f" ] || continue
		bn=$(basename "$f")
		[ -f "/data/mosdns/cache/$bn" ] || mv "$f" "/data/mosdns/cache/$bn" 2>/dev/null || true
	done
	[ -d /usr/share/v2ray ] && seed_and_bind /usr/share/v2ray /data/geodata
	if [ -d /usr/share/xray ] && ! grep -q ' /usr/share/xray ' /proc/mounts; then
		mount --bind /data/geodata /usr/share/xray 2>/dev/null || true
	fi
	[ -d /usr/share/passwall/rules ] && seed_and_bind /usr/share/passwall/rules /data/passwall/rules
	mkdir -p /etc/mosdns/rule/adlist
	seed_and_bind /etc/mosdns/rule/adlist /data/mosdns/adlist
	touch "$MARKER" 2>/dev/null || true
}

root_src() {
	awk '$2=="/"{print $1; exit}' /proc/mounts
}

resolve_dev() {
	local d="$1" mm node rootarg
	[ -n "$d" ] || return 1
	d=$(readlink -f "$d" 2>/dev/null || echo "$d")
	if [ "$d" = "/dev/root" ] || [ ! -e "$d" ]; then
		mm=$(awk '$5=="/"{print $3; exit}' /proc/self/mountinfo 2>/dev/null)
		if [ -n "$mm" ] && [ -e "/sys/dev/block/$mm" ]; then
			node=$(basename "$(readlink -f "/sys/dev/block/$mm")")
			[ -n "$node" ] && d="/dev/$node"
		fi
	fi
	if [ -e /dev/root ] && [ "$d" = "/dev/root" -o -z "$d" ]; then
		d=$(readlink -f /dev/root 2>/dev/null || true)
	fi
	if [ ! -b "$d" ]; then
		rootarg=$(sed -n 's/.*root=\([^ ]*\).*/\1/p' /proc/cmdline)
		case "$rootarg" in
			PARTUUID=*|UUID=*|LABEL=*)
				d=$(blkid -t "$rootarg" -o device 2>/dev/null | head -n 1)
				;;
			/dev/*)
				d="$rootarg"
				;;
		esac
	fi
	if [ ! -b "$d" ]; then
		d=$(awk '$2=="/" && $3=="ext4"{print $1; exit}' /proc/mounts)
	fi
	[ -b "$d" ] || return 1
	echo "$d"
}

disk_of_part() {
	local p="$1" n
	p=$(readlink -f "$p")
	n=$(basename "$p")
	case "$n" in
		nvme*n*p[0-9]*|mmcblk*p[0-9]*|loop*p[0-9]*)
			echo "/dev/${n%p*}"
			;;
		*)
			echo "/dev/${n%%[0-9]*}"
			;;
	esac
}

part_path() {
	local disk="$1" num="$2" bn
	bn=$(basename "$disk")
	case "$bn" in
		nvme*n*|mmcblk*|loop*)
			echo "${disk}p${num}"
			;;
		*)
			echo "${disk}${num}"
			;;
	esac
}

find_label_part() {
	local disk="$1" n p name
	[ -b "$disk" ] || return 1
	p=$(blkid -t "LABEL=$LABEL" -o device 2>/dev/null | head -n 1)
	[ -n "$p" ] && echo "$p" && return 0
	p=$(blkid -t "PARTLABEL=$LABEL" -o device 2>/dev/null | head -n 1)
	[ -n "$p" ] && echo "$p" && return 0
	for n in $(parted -m -s "$disk" print 2>/dev/null | awk -F: '$1 ~ /^[0-9]+$/ { print $1 }'); do
		name=$(parted -m -s "$disk" unit MiB print 2>/dev/null | awk -F: -v num="$n" '$1 == num { print $6 }')
		[ "$name" = "$LABEL" ] || continue
		p=$(part_path "$disk" "$n")
		[ -b "$p" ] && echo "$p" && return 0
	done
	return 1
}

label_part_num() {
	local disk="$1" n name

	if command -v sgdisk >/dev/null 2>&1; then
		n=$(sgdisk -p "$disk" 2>/dev/null | awk -v l="$LABEL" '
			/^ *[0-9]+ / {
				num=$1
				pname=$NF
				if (pname == l) { print num; exit }
			}')
		[ -n "$n" ] && echo "$n" && return 0
	fi
	for n in $(parted -m -s "$disk" print 2>/dev/null | awk -F: '$1 ~ /^[0-9]+$/ { print $1 }'); do
		name=$(parted -m -s "$disk" unit MiB print 2>/dev/null | awk -F: -v num="$n" '$1 == num { print $6 }')
		[ "$name" = "$LABEL" ] || continue
		echo "$n"
		return 0
	done
	return 1
}

fstab_has_data() {
	uci -q show fstab 2>/dev/null | grep -q "target='/data'"
}

enable_data_mount_service() {
	fstab_has_data || return 0
	[ -x /etc/init.d/fstab ] || return 0
	/etc/init.d/fstab enabled >/dev/null 2>&1 || /etc/init.d/fstab enable
}

write_fstab() {
	local uuid="$1" sid
	[ -n "$uuid" ] || return 1
	if fstab_has_data; then
		sid=$(uci -q show fstab | awk -F'[.=]' "/target='\\/data'/{print \$2; exit}")
		if [ -n "$sid" ]; then
			uci -q set "fstab.$sid.uuid=$uuid"
			uci -q set "fstab.$sid.target=/data"
			uci -q set "fstab.$sid.fstype=ext4"
			uci -q set "fstab.$sid.options=rw,noatime,nofail"
			uci -q set "fstab.$sid.enabled=1"
			uci -q commit fstab
			enable_data_mount_service
			return 0
		fi
	fi
	uci -q add fstab mount >/dev/null
	uci -q set "fstab.@mount[-1].uuid=$uuid"
	uci -q set "fstab.@mount[-1].target=/data"
	uci -q set "fstab.@mount[-1].fstype=ext4"
	uci -q set "fstab.@mount[-1].options=rw,noatime,nofail"
	uci -q set "fstab.@mount[-1].enabled=1"
	uci -q commit fstab
	enable_data_mount_service
}

mount_uuid() {
	local uuid="$1"
	mkdir -p /data
	if data_mounted; then
		return 0
	fi
	mount -t ext4 -o rw,noatime "UUID=$uuid" /data 2>/dev/null || \
		mount -t ext4 -o rw,noatime "/dev/disk/by-uuid/$uuid" /data 2>/dev/null || \
		return 1
}

refresh_parts() {
	local disk="$1"
	partx -u "$disk" >/dev/null 2>&1 || true
	partprobe "$disk" >/dev/null 2>&1 || true
	block detect >/dev/null 2>&1 || true
	sleep 1
}

gpt_needs_fix() {
	local disk="$1"
	parted -s "$disk" print 2>&1 | grep -qiE 'backup GPT|not all of the space'
}

fix_gpt_table() {
	local disk="$1" err table

	gpt_needs_fix "$disk" || return 0
	table=$(parted -m -s "$disk" print 2>/dev/null | awk -F: 'NR==2{print $6}')
	log "repairing GPT on $disk"
	if command -v sgdisk >/dev/null 2>&1; then
		if sgdisk -e "$disk" >>"$LOG" 2>&1; then
			refresh_parts "$disk"
			gpt_needs_fix "$disk" || return 0
		fi
		log "sgdisk -e failed on $disk"
	fi
	err=$(printf 'Fix\n' | parted ---pretend-input-tty -s "$disk" print 2>&1) || {
		log "parted GPT fix failed on $disk: ${err:-unknown}"
		return 1
	}
	[ -n "$err" ] && log "$err"
	refresh_parts "$disk"
	if [ "$table" = "gpt" ] && command -v sgdisk >/dev/null 2>&1; then
		sgdisk -e "$disk" >>"$LOG" 2>&1 || true
		refresh_parts "$disk"
	fi
	if gpt_needs_fix "$disk"; then
		log "GPT still broken on $disk (install gdisk and run sgdisk -e)"
		return 1
	fi
	return 0
}

parted_mkpart() {
	local disk="$1" start="$2" table="$3" err

	fix_gpt_table "$disk" || return 1
	if [ "$table" = "gpt" ]; then
		err=$(printf 'Fix\n' | parted ---pretend-input-tty -s "$disk" -- \
			mkpart "$LABEL" ext4 "${start}MiB" 100% 2>&1) || {
			log "parted mkpart failed: ${err:-unknown}"
			return 1
		}
	else
		err=$(printf 'Fix\n' | parted ---pretend-input-tty -s "$disk" -- \
			mkpart primary ext4 "${start}MiB" 100% 2>&1) || {
			log "parted mkpart failed: ${err:-unknown}"
			return 1
		}
	fi
	[ -n "$err" ] && log "$err"
	return 0
}

part_last_sector() {
	local disk="$1" num="$2" end

	if command -v sgdisk >/dev/null 2>&1; then
		end=$(sgdisk -i "$num" "$disk" 2>/dev/null | awk '/Last sector:/{print $3}')
		[ -n "$end" ] && echo "$end" && return 0
	fi
	end=$(parted -m -s "$disk" unit s print 2>/dev/null | awk -F: -v n="$num" '$1 == n { print $3 }')
	[ -n "$end" ] && echo "$end"
}

disk_last_sector() {
	local disk="$1" end

	if command -v sgdisk >/dev/null 2>&1; then
		end=$(sgdisk -p "$disk" 2>/dev/null | awk '/^Disk .* sectors:/{print $(NF-1)}' | tr -d ',')
		[ -n "$end" ] && echo "$end" && return 0
	fi
	if command -v blockdev >/dev/null 2>&1; then
		end=$(blockdev --getsz "$disk" 2>/dev/null)
		[ -n "$end" ] && echo "$end" && return 0
	fi
	end=$(parted -s "$disk" unit s print 2>/dev/null | awk '/^Disk \/dev\//{print $3}')
	[ -n "$end" ] && echo "${end%s}"
}

resize_data_fs() {
	local part="$1"
	[ -b "$part" ] || return 0
	command -v resize2fs >/dev/null 2>&1 || return 0
	resize2fs "$part" >>"$LOG" 2>&1 || log "resize2fs failed on $part"
}

grow_label_part() {
	local disk="$1" num start last disk_last uuid part fstype grew

	fix_gpt_table "$disk" || return 1

	num=$(label_part_num "$disk") || return 0
	[ -n "$num" ] || return 0

	if command -v sgdisk >/dev/null 2>&1; then
		start=$(sgdisk -i "$num" "$disk" 2>/dev/null | awk '/First sector:/{print $3}')
	else
		start=$(parted -m -s "$disk" unit s print 2>/dev/null | awk -F: -v n="$num" '$1 == n { print $2 }')
	fi
	last=$(part_last_sector "$disk" "$num")
	disk_last=$(disk_last_sector "$disk")
	[ -n "$start" ] && [ -n "$last" ] && [ -n "$disk_last" ] || return 0
	[ "$((disk_last - last))" -le 2048 ] && return 0

	part=$(part_path "$disk" "$num")
	uuid=$(blkid -o value -s UUID "$part" 2>/dev/null || true)
	fstype=$(blkid -o value -s TYPE "$part" 2>/dev/null || true)

	log "growing $LABEL partition $num on $disk (sectors $start-$last -> end)"
	grew=0
	if command -v sgdisk >/dev/null 2>&1; then
		if sgdisk -d "$num" "$disk" >>"$LOG" 2>&1 && \
		   sgdisk -n "$num:${start}:0" -c "$num:$LABEL" -t "$num:8300" "$disk" >>"$LOG" 2>&1; then
			grew=1
			[ -n "$uuid" ] && sgdisk -u "$num:$uuid" "$disk" >>"$LOG" 2>&1 || true
		else
			log "sgdisk grow failed on $disk part $num"
		fi
	fi
	if [ "$grew" = 0 ] && command -v parted >/dev/null 2>&1; then
		if parted -s "$disk" unit s resizepart "$num" "$disk_last" >>"$LOG" 2>&1; then
			grew=1
		else
			log "parted resizepart failed on $disk part $num"
			return 1
		fi
	fi
	[ "$grew" = 1 ] || return 1
	fix_gpt_table "$disk" || true
	refresh_parts "$disk"

	part=$(part_path "$disk" "$num")
	if [ -n "$fstype" ]; then
		resize_data_fs "$part"
	fi
}

mount_existing_label_part() {
	local disk="$1" part uuid fstype

	part=$(find_label_part "$disk" || true)
	[ -n "$part" ] || return 1

	grow_label_part "$disk"
	part=$(find_label_part "$disk" || echo "$part")

	fstype=$(blkid -o value -s TYPE "$part" 2>/dev/null || true)
	if [ -z "$fstype" ]; then
		if ! command -v mkfs.ext4 >/dev/null 2>&1; then
			log "mkfs.ext4 missing"
			return 1
		fi
		mkfs.ext4 -F -L "$LABEL" -m 0 "$part" || {
			log "mkfs.ext4 failed on $part"
			return 1
		}
		log "formatted prebuilt $LABEL $part"
	fi

	uuid=$(blkid -o value -s UUID "$part" 2>/dev/null || true)
	[ -n "$uuid" ] || return 1
	write_fstab "$uuid"
	if mount_uuid "$uuid"; then
		ensure_dirs
		log "mounted $LABEL $part uuid=$uuid"
		return 0
	fi
	log "mount failed for $LABEL $part uuid=$uuid"
	return 1
}

if [ -f "$INIT_DONE" ]; then
	exit 0
fi
trap retire_data_init EXIT

if data_mounted; then
	ROOT_PART=$(resolve_dev "$(root_src)") || {
		ensure_dirs
		exit 0
	}
	DISK=$(disk_of_part "$ROOT_PART")
	if [ -b "$DISK" ] && find_label_part "$DISK" >/dev/null 2>&1; then
		grow_label_part "$DISK" || true
	fi
	ensure_dirs
	exit 0
fi

ROOT_PART=$(resolve_dev "$(root_src)") || {
	log "cannot resolve root device, skip"
	exit 0
}
DISK=$(disk_of_part "$ROOT_PART")
if [ ! -b "$DISK" ]; then
	log "root disk not a block device: $DISK (part $ROOT_PART)"
	exit 0
fi

if ! command -v parted >/dev/null 2>&1; then
	log "parted missing, skip"
	exit 0
fi
if ! command -v sgdisk >/dev/null 2>&1; then
	log "sgdisk missing; GPT repair needs gdisk package"
	exit 1
fi

fix_gpt_table "$DISK" || {
	log "cannot repair GPT on $DISK, skip"
	exit 0
}

if mount_existing_label_part "$DISK"; then
	exit 0
fi

# Legacy fallback: images without a prebuilt LEDEDATA partition.
FREE_LINE=$(parted -m -s "$DISK" unit MiB print free 2>/dev/null | awk -F: '
	$0 ~ /:free;$/ {
		start=$2; size=$4
		gsub(/MiB/,"",start); gsub(/MiB/,"",size)
		last_start=start; last_size=size
	}
	END { if (last_size+0 > 0) print last_start, last_size }
')
FREE_START=$(echo "$FREE_LINE" | awk '{print $1}')
FREE_SIZE=$(echo "$FREE_LINE" | awk '{print $2}')
FREE_SIZE=${FREE_SIZE%.*}

if [ -z "$FREE_SIZE" ] || [ "$FREE_SIZE" -lt "$MIN_MIB" ]; then
	log "no LEDEDATA partition and no leftover >= ${MIN_MIB}MiB on $DISK (got ${FREE_SIZE:-0}), skip"
	exit 0
fi

TABLE=$(parted -m -s "$DISK" print 2>/dev/null | awk -F: 'NR==2{print $6}')
log "legacy create $LABEL on $DISK from ${FREE_START}MiB table=$TABLE free=${FREE_SIZE}MiB"

parted_mkpart "$DISK" "$FREE_START" "$TABLE" || exit 1

refresh_parts "$DISK"

NEW_N=$(parted -m -s "$DISK" print 2>/dev/null | awk -F: '
	$1 ~ /^[0-9]+$/ { n=$1 }
	END { print n }
')
NEW_PART=$(part_path "$DISK" "$NEW_N")
i=0
while [ ! -b "$NEW_PART" ] && [ "$i" -lt 10 ]; do
	sleep 1
	refresh_parts "$DISK"
	i=$((i + 1))
done
if [ ! -b "$NEW_PART" ]; then
	log "new partition $NEW_PART did not appear"
	exit 1
fi

FSTYPE=$(blkid -o value -s TYPE "$NEW_PART" 2>/dev/null || true)
if [ -z "$FSTYPE" ]; then
	if ! command -v mkfs.ext4 >/dev/null 2>&1; then
		log "mkfs.ext4 missing"
		exit 1
	fi
	mkfs.ext4 -F -L "$LABEL" -m 0 "$NEW_PART" || {
		log "mkfs.ext4 failed on $NEW_PART"
		exit 1
	}
	log "formatted $NEW_PART ext4 label=$LABEL"
fi

UUID=$(blkid -o value -s UUID "$NEW_PART" 2>/dev/null || true)
if [ -z "$UUID" ]; then
	log "no UUID for $NEW_PART"
	exit 1
fi
write_fstab "$UUID"
if mount_uuid "$UUID"; then
	ensure_dirs
	log "mounted /data uuid=$UUID part=$NEW_PART"
	exit 0
fi
log "mount failed uuid=$UUID part=$NEW_PART"
exit 1
