#!/bin/sh
# Apply WAN HTTPS. Usage: lede-wan-https [status|<0|1> [port]]
set +e
. /lib/functions.sh

CONF=/etc/nginx/conf.d/wan-https.conf
CRT=/etc/nginx/conf.d/_lan.crt
KEY=/etc/nginx/conf.d/_lan.key
NAME=Allow-WAN-HTTPS
SID=lede_wan_https
OLD_REDIR=10443-443
OLD_RULE=Allow-HTTPS-10443

drop_by_name() {
	local typ="$1" want="$2" sid name
	for sid in $(uci -q show firewall | sed -n "s/^firewall\\.\\([^.]*\\)=${typ}$/\\1/p"); do
		name=$(uci -q get "firewall.$sid.name")
		[ "$name" = "$want" ] || continue
		uci -q delete "firewall.$sid"
	done
}

fw_present() {
	[ "$(uci -q get firewall.${SID})" = rule ] && return 0
	local sid name
	for sid in $(uci -q show firewall | sed -n 's/^firewall\.\([^.]*\)=rule$/\1/p'); do
		name=$(uci -q get "firewall.$sid.name")
		[ "$name" = "$NAME" ] && return 0
	done
	return 1
}

detect_port() {
	local p
	p=$(uci -q get lede-remote.main.port)
	[ -n "$p" ] || p=$(uci -q get firewall.${SID}.dest_port)
	[ -n "$p" ] || p=10443
	echo "$p"
}

listen_on() {
	local p="$1"
	netstat -lnt 2>/dev/null | grep -q ":${p} " && return 0
	return 1
}

emit_status() {
	local port ngx listen fw en
	port=$(detect_port)
	ngx=0
	[ -f "$CONF" ] && ngx=1
	listen=0
	listen_on "$port" && listen=1
	fw=0
	fw_present && fw=1
	en=$(uci -q get lede-remote.main.enabled)
	[ "$en" = 1 ] || en=0
	printf '{"ok":true,"enabled":%s,"port":%s,"firewall":%s,"nginx":%s,"listen":%s,"rule":"%s","src":"wan","proto":"tcp","target":"ACCEPT"}\n' \
		"$en" "$port" "$fw" "$ngx" "$listen" "$NAME"
}

if [ "$1" = status ]; then
	emit_status
	exit 0
fi

if [ -n "$1" ]; then
	case "$1" in
		1|on|true|yes) en=1 ;;
		*) en=0 ;;
	esac
	port=$2
	uci -q set lede-remote.main=https
	uci -q set lede-remote.main.enabled="$en"
	[ -n "$port" ] && uci -q set lede-remote.main.port="$port"
	uci commit lede-remote
else
	en=$(uci -q get lede-remote.main.enabled)
	port=$(uci -q get lede-remote.main.port)
fi

[ -n "$port" ] || port=10443
case "$port" in
	*[!0-9]*) port=10443 ;;
esac
[ "$port" -ge 1024 ] && [ "$port" -le 65535 ] || port=10443
[ "$port" != 80 ] && [ "$port" != 443 ] || port=10443
[ "$en" = 1 ] || en=0

write_nginx() {
	cat > "$CONF" <<EOF
# Generated by /usr/libexec/lede-wan-https. Do not edit.
server {
	listen ${port} ssl;
	server_name _;
	include conf.d/*.locations;
	ssl_certificate ${CRT};
	ssl_certificate_key ${KEY};
	ssl_session_cache shared:SSL:32k;
	ssl_session_timeout 64m;
	access_log off;
}
EOF
}

rm -f /etc/nginx/conf.d/wan-10443.conf
drop_by_name redirect "$OLD_REDIR"
drop_by_name rule "$OLD_RULE"
drop_by_name rule "$NAME"
uci -q delete "firewall.${SID}"

if [ "$en" = 1 ]; then
	write_nginx
	uci set "firewall.${SID}=rule"
	uci set "firewall.${SID}.name=$NAME"
	uci set "firewall.${SID}.enabled=1"
	uci set "firewall.${SID}.family=ipv4"
	uci set "firewall.${SID}.proto=tcp"
	uci set "firewall.${SID}.src=wan"
	uci set "firewall.${SID}.dest_port=$port"
	uci set "firewall.${SID}.target=ACCEPT"
else
	rm -f "$CONF"
fi

uci commit firewall
fw4 reload >/dev/null 2>&1 || true

( sleep 1
	if [ -x /etc/init.d/nginx ]; then
		/etc/init.d/nginx reload >/dev/null 2>&1 || /etc/init.d/nginx restart >/dev/null 2>&1 || true
	fi
) >/dev/null 2>&1 &

emit_status
exit 0
