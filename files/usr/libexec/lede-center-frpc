#!/bin/sh
# Regional center frpc: write-config | apply | status
set -e
. /lib/functions.sh

CONF=/var/etc/lede-center-frpc.toml
PIDFILE=/var/run/lede-center-frpc.pid
CA_STORE=/etc/lede-center/frps-ca.crt
REG_STATE=/etc/lede-center/register.state
REG_PID=/tmp/lede-center-register.pid
REG_LOG=/tmp/lede-center-register.log
REG_DETAIL=""

uci_get() {
	uci -q get "lede-center.main.$1" 2>/dev/null || true
}

default_ca_file() {
	local f
	f=$(uci_get ca_file)
	[ -n "$f" ] && [ -f "$f" ] && printf '%s' "$f" && return 0
	[ -f /etc/lede-center/frps-ca.crt ] && printf '%s' /etc/lede-center/frps-ca.crt && return 0
	return 1
}

# When WAN DNS hits an unreachable public IP, connect to portal_lan_host but keep TLS SNI = server.
portal_curl_resolve() {
	local server pport lan
	server="$1"
	pport="$2"
	lan=$(uci_get portal_lan_host)
	[ -n "$lan" ] || return 0
	case "$lan" in
	*[!0-9.a-fA-F:]*)
		return 0
		;;
	esac
	printf '%s' "--resolve ${server}:${pport}:${lan}"
}

valid_site_id() {
	case "$1" in
	''|*[!a-zA-Z0-9_-]*)
		return 1
		;;
	esac
	return 0
}

# 只拒绝本机回环。门店 LAN 与中心机不是同一张网，地址数字相同也合法。
tunnel_local_ip_bad() {
	case "$1" in
	127.0.0.1|::1|localhost)
		return 0
		;;
	esac
	return 1
}

uci_config_valid() {
	local site token rpluc
	site=$(uci_get site_id)
	token=$(uci_get token)
	rpluc=$(uci_get remote_port_luci)
	valid_site_id "$site" || return 1
	[ -n "$token" ] || return 1
	[ -n "$rpluc" ] || return 1
	return 0
}

require_center_ca() {
	local ca_path
	ca_path=$(default_ca_file) || true
	if [ -z "$ca_path" ]; then
		echo "未安装中心 CA：请在 LuCI 点击「从中心下载并导入 CA」，或放置证书到 /etc/lede-center/frps-ca.crt" >&2
		return 1
	fi
	printf '%s' "$ca_path"
	return 0
}

write_config() {
	local en site server port token rpluc rpssh lport tmp lip ca_path
	en=$(uci_get enabled)
	site=$(uci_get site_id)
	server=$(uci_get server)
	port=$(uci_get port)
	token=$(uci_get token)
	rpluc=$(uci_get remote_port_luci)
	rpssh=$(uci_get remote_port_ssh)
	lport=$(uci_get local_luci_port)
	lip=$(uci_get local_luci_ip)
	[ -n "$server" ] || server=center.123.gd.cn
	[ -n "$port" ] || port=18007
	[ -n "$lport" ] || lport=443
	if [ -z "$lip" ]; then
		lip=$(uci -q get network.lan.ipaddr)
	fi
	[ -n "$lip" ] || lip=127.0.0.1

	mkdir -p "$(dirname "$CONF")"

	if [ "$en" != "1" ]; then
		: >"$CONF"
		return 0
	fi

	if ! valid_site_id "$site"; then
		echo "invalid site_id (use a-z A-Z 0-9 _ -)" >&2
		return 1
	fi
	[ -n "$token" ] || {
		echo "token is required when enabled" >&2
		return 1
	}
	[ -n "$rpluc" ] || {
		echo "remote_port_luci is required when enabled" >&2
		return 1
	}
	ca_path=$(require_center_ca) || return 1

	tmp="${CONF}.tmp.$$"
	cat >"$tmp" <<EOF
serverAddr = "$server"
serverPort = $port

auth.method = "token"
auth.token = "$token"

transport.tls.enable = true
transport.tls.disableCustomTLSFirstByte = true
transport.tls.trustedCaFile = "$ca_path"

EOF

	cat >>"$tmp" <<EOF

[[proxies]]
name = "${site}-luci"
type = "tcp"
localIP = "$lip"
localPort = $lport
remotePort = $rpluc
EOF

	if [ -n "$rpssh" ] && [ "$rpssh" != "0" ]; then
		cat >>"$tmp" <<EOF

[[proxies]]
name = "${site}-ssh"
type = "tcp"
localIP = "$lip"
localPort = 22
remotePort = $rpssh
EOF
	fi

	append_tunnel_proxies "$site" "$tmp" || {
		rm -f "$tmp"
		return 1
	}
	mv "$tmp" "$CONF"
}

append_tunnel_proxy() {
	local section="$1"
	local site="$2"
	local tmp="$3"
	local en pname lip lport rport
	config_get en "$section" enabled
	[ "$en" = "1" ] || return 0
	config_get pname "$section" name
	config_get lip "$section" local_ip
	config_get lport "$section" local_port
	config_get rport "$section" remote_port
	[ -n "$lip" ] && [ -n "$lport" ] && [ -n "$rport" ] || return 0
	valid_site_id "$pname" || return 0
	if tunnel_local_ip_bad "$lip"; then
		echo "tunnel ${pname}: local_ip ${lip} 无效（请填门店 LAN 内设备 IP，勿填 127.0.0.1）" >&2
		TUNNEL_ERR=1
		return 1
	fi
	cat >>"$tmp" <<EOF

[[proxies]]
name = "${site}-${pname}"
type = "tcp"
localIP = "$lip"
localPort = $lport
remotePort = $rport
EOF
}

append_tunnel_proxies() {
	local site="$1"
	local tmp="$2"
	TUNNEL_ERR=0
	config_load lede-center
	config_foreach append_tunnel_proxy tunnel "$site" "$tmp"
	[ "${TUNNEL_ERR:-0}" = 0 ] || return 1
}

drop_tunnel_firewall_rules() {
	local sid name
	for sid in $(uci -q show firewall 2>/dev/null | sed -n 's/^firewall\.\([^.]*\)=rule$/\1/p'); do
		name=$(uci -q get "firewall.$sid.name" 2>/dev/null) || continue
		case "$name" in
		lede-center-tunnel-*)
			uci -q delete "firewall.$sid"
			;;
		esac
	done
}

sync_one_tunnel_firewall() {
	local section="$1" site="$2"
	local en pname lip lport lanip rulename
	config_get en "$section" enabled
	[ "$en" = "1" ] || return 0
	config_get pname "$section" name
	config_get lip "$section" local_ip
	config_get lport "$section" local_port
	[ -n "$lip" ] && [ -n "$lport" ] && [ -n "$pname" ] || return 0
	valid_site_id "$pname" || return 0
	case "$lip" in
	127.0.0.1|::1) return 0 ;;
	esac
	lanip=$(uci -q get network.lan.ipaddr)
	[ "$lip" = "$lanip" ] && return 0
	rulename="lede-center-tunnel-${site}-${pname}"
	uci add firewall rule >/dev/null
	uci set "firewall.@rule[-1].name=$rulename"
	uci set "firewall.@rule[-1].enabled=1"
	uci set "firewall.@rule[-1].family=ipv4"
	uci set "firewall.@rule[-1].proto=tcp"
	uci set "firewall.@rule[-1].src=lan"
	uci set "firewall.@rule[-1].dest=lan"
	uci set "firewall.@rule[-1].dest_ip=$lip"
	uci set "firewall.@rule[-1].dest_port=$lport"
	uci set "firewall.@rule[-1].target=ACCEPT"
}

sync_tunnel_firewall() {
	local en site
	en=$(uci_get enabled)
	site=$(uci_get site_id)
	drop_tunnel_firewall_rules
	if [ "$en" = "1" ] && valid_site_id "$site"; then
		config_load lede-center
		config_foreach sync_one_tunnel_firewall tunnel "$site"
	fi
	uci commit firewall 2>/dev/null || true
	fw4 reload >/dev/null 2>&1 || /etc/init.d/firewall reload >/dev/null 2>&1 || true
}

frpc_running() {
	[ -x /usr/bin/frpc ] || return 1
	pidof frpc >/dev/null 2>&1
}

# UCI 已启用且参数完整时：保证 toml 存在且 frpc 进程在跑（仅 status/ensure 调用）
ensure_service() {
	local i
	[ "$(uci_get enabled)" = "1" ] || return 0
	uci_config_valid || return 0
	[ -x /usr/bin/frpc ] || return 0
	if [ ! -s "$CONF" ]; then
		write_config 2>/dev/null || return 0
	fi
	[ -s "$CONF" ] || return 0
	frpc_running && return 0
	/etc/init.d/lede-center-frpc restart 2>/dev/null \
		|| /etc/init.d/lede-center-frpc start 2>/dev/null \
		|| true
	i=0
	while [ $i -lt 8 ]; do
		frpc_running && return 0
		sleep 1
		i=$((i + 1))
	done
	return 0
}

status_tunnel_json_line() {
	local section="$1"
	local en pname lip lport rport
	config_get en "$section" enabled
	[ "$en" = "1" ] || return 0
	config_get pname "$section" name
	config_get lip "$section" local_ip
	config_get lport "$section" local_port
	config_get rport "$section" remote_port
	[ -n "$pname" ] && [ -n "$lip" ] && [ -n "$lport" ] && [ -n "$rport" ] || return 0
	valid_site_id "$pname" || return 0
	if [ -n "$STATUS_TUNNELS_JSON" ]; then
		STATUS_TUNNELS_JSON="$STATUS_TUNNELS_JSON,"
	fi
	STATUS_TUNNELS_JSON="$STATUS_TUNNELS_JSON{\"name\":\"$pname\",\"local_ip\":\"$lip\",\"local_port\":$lport,\"remote_port\":$rport}"
}

status_json() {
	local en run cfg uci_ok
	en=$(uci_get enabled)
	run=0
	cfg=0
	uci_ok=0
	STATUS_TUNNELS_JSON=""
	if [ "$en" = "1" ] && uci_config_valid; then
		uci_ok=1
		ensure_service
	fi
	[ -s "$CONF" ] && cfg=1
	frpc_running && run=1
	if [ "$en" = "1" ]; then
		config_load lede-center
		config_foreach status_tunnel_json_line tunnel
	fi
	[ -n "$STATUS_TUNNELS_JSON" ] || STATUS_TUNNELS_JSON=""
	ca_ok=0
	default_ca_file >/dev/null 2>&1 && ca_ok=1
	frpc_bin=0
	[ -x /usr/bin/frpc ] && frpc_bin=1
	reg_phase=none
	reg_fails=0
	reg_detail=""
	if [ -f "$REG_STATE" ]; then
		reg_phase=$(sed -n 's/^phase=//p' "$REG_STATE" | head -1)
		reg_fails=$(sed -n 's/^fails=//p' "$REG_STATE" | head -1)
		reg_detail=$(sed -n 's/^detail=//p' "$REG_STATE" | head -1)
	fi
	case "$reg_phase" in
	pending|ok|failed|none) ;;
	*) reg_phase=none ;;
	esac
	case "$reg_fails" in
	''|*[!0-9]*) reg_fails=0 ;;
	esac
	printf '{"enabled":%s,"running":%s,"config":%s,"uci_ok":%s,"ca_installed":%s,"frpc_installed":%s,"site_id":"%s","server":"%s","port":"%s","remote_port_luci":"%s","tunnels":[%s],"register_phase":"%s","register_fails":%s,"register_detail":"%s"}' \
		"$([ "$en" = "1" ] && echo 1 || echo 0)" \
		"$run" \
		"$cfg" \
		"$uci_ok" \
		"$ca_ok" \
		"$frpc_bin" \
		"$(uci_get site_id)" \
		"$(uci_get server)" \
		"$(uci_get port)" \
		"$(uci_get remote_port_luci)" \
		"$STATUS_TUNNELS_JSON" \
		"$reg_phase" \
		"$reg_fails" \
		"$(json_esc "$reg_detail")"
}

json_esc() {
	printf '%s' "$1" | tr '\r\n' '  ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

register_mark() {
	local phase="$1" fails="$2" detail="$3"
	mkdir -p /etc/lede-center
	detail=$(printf '%s' "$detail" | tr '\r\n' '  ' | cut -c1-180)
	printf 'phase=%s\nfails=%s\ndetail=%s\n' "$phase" "$fails" "$detail" > "$REG_STATE.tmp"
	mv "$REG_STATE.tmp" "$REG_STATE"
}

register_portal() {
	local server pport token url body resp resolve rc
	REG_DETAIL=""
	[ "$(uci_get enabled)" = "1" ] || return 2
	uci_config_valid || return 2
	token=$(uci_get token)
	[ -n "$token" ] || return 2
	# Portal HTTPS (18443) may use panel self-signed cert; frps CA is for frpc only (see import_ca -k).
	server=$(uci_get server)
	[ -n "$server" ] || server=center.123.gd.cn
	pport=$(uci_get portal_port)
	[ -n "$pport" ] || pport=18443
	body=$(ucode -e "import { register_payload } from '/usr/share/ucode/lede-center-portal.uc'; print(sprintf('%J', register_payload()));" 2>/dev/null) || {
		REG_DETAIL="portal register: build payload failed"
		echo "$REG_DETAIL" >&2
		return 1
	}
	url="https://${server}:${pport}/home/api/gateway/register"
	resolve=$(portal_curl_resolve "$server" "$pport")
	resp=""
	rc=0
	# shellcheck disable=SC2086
	resp=$(curl -sfk --max-time 25 $resolve \
		-H "Content-Type: application/json; charset=utf-8" \
		-H "Authorization: Bearer ${token}" \
		-d "$body" "$url" 2>&1) || rc=$?
	if [ "$rc" -ne 0 ]; then
		if [ -z "$resp" ]; then
			resp="curl exit ${rc} (无法访问 ${url}，请检查门店 WAN、DNS、18443 放行及 CA/Token)"
		fi
		REG_DETAIL="portal register failed: $resp"
		echo "$REG_DETAIL" >&2
		return 1
	fi
	case "$resp" in
	*"\"ok\":true"*|*'"ok": true'*)
		echo "portal register ok: $(uci_get site_id)" >&2
		return 0
		;;
	*)
		REG_DETAIL="portal register: $resp"
		echo "$REG_DETAIL" >&2
		return 1
		;;
	esac
}

# One automatic run: try immediately, then twice more, 30s apart.
# 0 = registered, 2 = nothing to register. Three failures leave phase=failed.
register_retry_worker() {
	local n=0 rc=0 detail=""
	trap '' HUP
	echo $$ > "$REG_PID"
	register_mark pending 0 ""
	while [ "$n" -lt 3 ]; do
		rc=0
		register_portal || rc=$?
		if [ "$rc" -eq 0 ]; then
			register_mark ok 0 ""
			rm -f "$REG_PID"
			return 0
		fi
		if [ "$rc" -eq 2 ]; then
			register_mark none 0 ""
			rm -f "$REG_PID"
			return 0
		fi
		n=$((n + 1))
		detail=$REG_DETAIL
		if [ "$n" -lt 3 ]; then
			register_mark pending "$n" "$detail"
			sleep 30
		fi
	done
	register_mark failed 3 "$detail"
	rm -f "$REG_PID"
	return 0
}

register_retry_async() {
	local old
	if [ -f "$REG_PID" ]; then
		old=$(cat "$REG_PID" 2>/dev/null || true)
		[ -n "$old" ] && kill "$old" 2>/dev/null || true
		rm -f "$REG_PID"
	fi
	register_mark pending 0 ""
	(
		trap '' HUP
		/usr/libexec/lede-center-frpc register-retry-worker
	) </dev/null >>"$REG_LOG" 2>&1 &
	return 0
}

# One quiet POST. Restores a site the center deleted. Does not arm the manual button.
register_keepalive() {
	local rc=0 old
	[ "$(uci_get enabled)" = "1" ] || return 0
	if [ -f "$REG_PID" ]; then
		old=$(cat "$REG_PID" 2>/dev/null || true)
		if [ -n "$old" ] && kill -0 "$old" 2>/dev/null; then
			return 0
		fi
	fi
	register_portal || rc=$?
	if [ "$rc" -eq 0 ]; then
		register_mark ok 0 ""
	fi
	return 0
}

import_ca() {
	local server pport url tmp sha
	server=$(uci_get server)
	[ -n "$server" ] || server=center.123.gd.cn
	pport=$(uci_get portal_port)
	[ -n "$pport" ] || pport=18443
	url="https://${server}:${pport}/home/ca/root-ca.crt"
	resolve=$(portal_curl_resolve "$server" "$pport")
	mkdir -p /etc/lede-center
	tmp="${CA_STORE}.tmp.$$"
	# shellcheck disable=SC2086
	if ! curl -sfk --max-time 30 $resolve -o "$tmp" "$url"; then
		rm -f "$tmp"
		printf '{"ok":false,"error":"无法从中心下载 CA（%s）。公网入口 LEDE 须转发 WAN:18443→192.168.6.251:18443；若门店能访问中心内网，可在 LuCI 填写「中心门户内网 IP」如 192.168.6.251 后重试"}\n' "$url"
		return 1
	fi
	if ! openssl x509 -in "$tmp" -noout -subject >/dev/null 2>&1; then
		rm -f "$tmp"
		printf '{"ok":false,"error":"下载内容不是有效的 X.509 证书"}\n'
		return 1
	fi
	mv "$tmp" "$CA_STORE"
	chmod 644 "$CA_STORE"
	sha=$(sha256sum "$CA_STORE" 2>/dev/null | awk '{print $1}')
	uci set "lede-center.main.ca_file=$CA_STORE"
	uci -q delete lede-center.main.tls_insecure 2>/dev/null || true
	uci commit lede-center
	printf '{"ok":true,"path":"%s","url":"%s","sha256":"%s"}\n' \
		"$CA_STORE" "$url" "${sha:-}"
}

case "${1:-status}" in
import-ca)
	import_ca || exit 1
	if [ "$(uci_get enabled)" = "1" ] && uci_config_valid; then
		write_config || exit 1
		/etc/init.d/lede-center-frpc restart 2>/dev/null || true
		register_retry_async
	fi
	;;
register-portal)
	rc=0
	register_portal || rc=$?
	if [ "$rc" -eq 0 ]; then
		register_mark ok 0 ""
		exit 0
	fi
	if [ "$rc" -eq 2 ]; then
		register_mark none 0 ""
		exit 0
	fi
	register_mark failed 3 "$REG_DETAIL"
	exit 1
	;;
register-retry-worker)
	register_retry_worker
	;;
register-retry)
	register_retry_async
	;;
register-keepalive)
	register_keepalive
	;;
write-config)
	write_config
	;;
apply)
	en=$(uci_get enabled)
	if [ "$en" = "1" ]; then
		write_config || exit 1
		if [ -s "$CONF" ] && [ -x /usr/bin/frpc ]; then
			/usr/bin/frpc verify -c "$CONF" || {
				echo "frpc verify failed; fix config above" >&2
				exit 1
			}
		fi
	else
		write_config || true
		register_mark none 0 ""
	fi
	sync_tunnel_firewall
	/etc/init.d/lede-center-frpc stop 2>/dev/null || true
	killall frpc 2>/dev/null || true
	sleep 1
	if [ "$en" = "1" ]; then
		/etc/init.d/lede-center-frpc start || exit 1
		sleep 2
		pidof frpc >/dev/null || {
			echo "frpc failed to start; see logread | grep frpc" >&2
			exit 1
		}
		register_retry_async
	fi
	;;
restart)
	en=$(uci_get enabled)
	[ "$en" = "1" ] || exit 0
	write_config || exit 1
	if [ -s "$CONF" ] && [ -x /usr/bin/frpc ]; then
		/usr/bin/frpc verify -c "$CONF" || exit 1
	fi
	/etc/init.d/lede-center-frpc restart || exit 1
	sleep 2
	pidof frpc >/dev/null || {
		echo "frpc failed to start; see logread | grep frpc" >&2
		exit 1
	}
	register_retry_async
	;;
status|ensure)
	status_json
	;;
*)
	echo "usage: $0 {write-config|apply|restart|ensure|status|import-ca|register-portal|register-retry|register-keepalive}" >&2
	exit 1
	;;
esac
